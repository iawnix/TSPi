{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS scientific claim input",
  "type": "object",
  "required": ["claim_id", "node_id", "kind", "statement", "required_gates", "details"],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^claim_[A-Za-z0-9_.-]+$", "maxLength": 256},
    "node_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "parent_claim_id": {"type": ["string", "null"], "pattern": "^claim_[A-Za-z0-9_.-]+$", "maxLength": 256},
    "kind": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[0-9]+$", "maxLength": 256},
    "statement": {"type": "string", "minLength": 1, "maxLength": 8000},
    "required_gates": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "details": {"type": "object"}
  },
  "additionalProperties": false
}
