{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS node",
  "type": "object",
  "required": ["schema_version", "node_id", "phase", "lifecycle", "hypothesis", "closure"],
  "properties": {
    "schema_version": {"const": "ts-node"},
    "node_id": {"type": "string", "minLength": 1},
    "parent_node": {"type": ["string", "null"]},
    "phase": {
      "enum": ["preflight", "endpoint", "rp_conformer_generation", "candidate_generation", "tsfreq_validation", "connectivity_validation", "accepted_audit", "pathway_audit"]
    },
    "lifecycle": {"enum": ["running", "closed", "stopped"]},
    "hypothesis": {"type": "string", "minLength": 1},
    "expected_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "pathway_ref": {"type": ["object", "null"]},
    "hypothesis_ref": {"anyOf": [{"$ref": "mechanism.schema.json#/$defs/hypothesis_ref"}, {"type": "null"}]},
    "solution_ref": {
      "anyOf": [
        {
          "type": "object",
          "required": ["solution_id"],
          "properties": {
            "solution_id": {"type": "string", "minLength": 1},
            "summary": {"type": ["string", "null"]},
            "strategy": {"type": ["string", "null"]},
            "parent_solution_id": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        },
        {"type": "null"}
      ]
    },
    "branch_context": {
      "anyOf": [
        {
          "type": "object",
          "required": ["relation", "from_node", "anchor_node"],
          "properties": {
            "relation": {
              "enum": ["continue_parent", "new_solution_branch", "new_hypothesis_branch", "new_pathway_branch", "administrative_followup"]
            },
            "from_node": {"type": "string", "minLength": 1},
            "anchor_node": {"type": "string", "minLength": 1},
            "reason_code": {"type": "string", "minLength": 1},
            "changed_variable": {"type": "string", "minLength": 1},
            "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": true
        },
        {"type": "null"}
      ]
    },
    "initial_mechanism_hypothesis": {
      "anyOf": [{"$ref": "mechanism.schema.json#/$defs/mechanism_hypothesis_input"}, {"type": "null"}]
    },
    "created_by_decision": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "artifacts": {"type": "object"},
    "closure": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["program_status", "claim_verdict", "program", "mechanism"],
          "properties": {
            "program_status": {"enum": ["completed", "failed", "stopped", "not_run"]},
            "claim_verdict": {"enum": ["supported", "refuted", "inconclusive", "not_evaluated"]},
            "program": {"type": "object"},
            "mechanism": {"type": "object"},
            "open_questions": {"type": "array"}
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "additionalProperties": true
}
