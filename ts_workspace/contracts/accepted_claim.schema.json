{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accepted TS scientific claim",
  "type": "object",
  "required": [
    "schema_version",
    "acceptance_id",
    "node_id",
    "policy",
    "target_ref",
    "gate_result_refs",
    "summary",
    "decision_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "ts-accepted-claim/1"},
    "acceptance_id": {"type": "string", "pattern": "^acc_[A-Za-z0-9_.-]+$"},
    "node_id": {"type": "string", "minLength": 1},
    "policy": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[0-9]+$"},
    "target_ref": {"type": "string", "pattern": "^claim_[A-Za-z0-9_.-]+$"},
    "gate_result_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^gr_[A-Za-z0-9_.-]+$"}
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "decision_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
