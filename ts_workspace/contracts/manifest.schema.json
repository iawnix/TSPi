{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS workspace manifest",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "current_focus",
    "hypothesis_contract_version",
    "accepted_ts_refs",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "ts-workspace"},
    "created_at": {"type": "string", "minLength": 1},
    "current_focus": {"type": ["string", "null"]},
    "hypothesis_contract_version": {"type": "string", "minLength": 1},
    "accepted_ts_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "provenance": {"type": "array"}
  },
  "additionalProperties": true
}
