{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accepted TS artifact",
  "type": "object",
  "required": [
    "accepted_id",
    "node_id",
    "phase",
    "hypothesis_ref",
    "required_gates",
    "evidence_refs"
  ],
  "properties": {
    "accepted_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "phase": {"const": "accepted_audit"},
    "hypothesis_ref": {"$ref": "mechanism.schema.json#/$defs/hypothesis_ref"},
    "required_gates": {
      "type": "array",
      "items": {"enum": ["tsfreq_gate", "connectivity_gate"]},
      "contains": {"const": "tsfreq_gate"},
      "minContains": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 2
    }
  },
  "allOf": [
    {
      "properties": {
        "required_gates": {
          "contains": {"const": "connectivity_gate"},
          "minContains": 1
        }
      }
    }
  ],
  "additionalProperties": true
}
