{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accepted TS artifact",
  "type": "object",
  "required": [
    "schema_version",
    "accepted_id",
    "node_id",
    "node_type",
    "audit_scope",
    "hypothesis_ref",
    "required_gates",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "ts-accepted/2"},
    "accepted_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "node_type": {"const": "audit"},
    "audit_scope": {"enum": ["transition_state", "elementary_step"]},
    "hypothesis_ref": {"$ref": "mechanism.schema.json#/$defs/hypothesis_ref"},
    "required_gates": {
      "type": "array",
      "items": {
        "enum": [
          "tsfreq_gate",
          "connectivity_gate",
          "stereochemical_connectivity_gate",
          "endpoint_identity_gate",
          "intermediate_identity_gate",
          "electronic_structure_gate",
          "state_character_gate",
          "shared_basin_consistency_gate"
        ]
      },
      "contains": {"const": "tsfreq_gate"},
      "minContains": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 2
    }
  },
  "allOf": [
    {
      "properties": {
        "required_gates": {
          "contains": {"const": "connectivity_gate"},
          "minContains": 1
        }
      }
    }
  ],
  "additionalProperties": false
}
