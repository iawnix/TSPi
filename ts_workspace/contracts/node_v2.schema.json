{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS research node",
  "type": "object",
  "required": ["schema_version", "node_id", "parent_node", "node_type", "objective", "lifecycle", "expected_evidence", "evidence_refs", "created_by_decision", "started_at", "artifacts", "closure"],
  "properties": {
    "schema_version": {"const": "ts-node/2"},
    "node_id": {"type": "string", "minLength": 1},
    "parent_node": {"type": ["string", "null"]},
    "node_type": {"enum": ["intake", "mechanism", "candidate_search", "validation", "audit"]},
    "objective": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["running", "closed", "stopped"]},
    "mechanism_action": {"enum": ["propose", "compare", "revise", "evaluate"]},
    "candidate_kind": {"enum": ["transition_state", "endpoint_conformer", "intermediate", "crossing_point"]},
    "validation_scope": {"enum": ["tsfreq", "connectivity", "electronic_structure", "state_character", "thermochemistry", "method_robustness", "geometry_identity"]},
    "audit_scope": {"enum": ["transition_state", "elementary_step", "pathway", "study"]},
    "attempt_kind": {"enum": ["primary", "recalculation"]},
    "recalculation_ref": {"type": ["object", "null"]},
    "hypothesis_ref": {"type": ["object", "null"]},
    "proposed_hypothesis": {"type": ["object", "null"]},
    "solution_ref": {
      "anyOf": [
        {
          "type": "object",
          "required": ["solution_id"],
          "properties": {
            "solution_id": {"type": "string", "minLength": 1},
            "summary": {"type": ["string", "null"]},
            "strategy": {"type": ["string", "null"]},
            "parent_solution_id": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "pathway_ref": {"type": ["object", "null"]},
    "branch_context": {"type": ["object", "null"]},
    "expected_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "created_by_decision": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "artifacts": {"type": "object"},
    "closure": {"type": ["object", "null"]}
  },
  "additionalProperties": true
}
