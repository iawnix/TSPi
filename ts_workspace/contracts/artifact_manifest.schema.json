{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS node artifact manifest",
  "type": "object",
  "required": ["schema_version", "node_id", "phase", "owned_artifacts", "consumed_artifacts", "evidence_refs"],
  "properties": {
    "schema_version": {"const": "ts-artifact-manifest"},
    "node_id": {"type": "string", "minLength": 1},
    "phase": {
      "enum": ["preflight", "endpoint", "rp_conformer_generation", "candidate_generation", "tsfreq_validation", "connectivity_validation", "accepted_audit", "pathway_audit"]
    },
    "claim_layer": {"type": "string", "minLength": 1},
    "cross_node_consumption_reason": {"type": "string"},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "owned_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "consumed_artifacts": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/artifact_ref"},
          {
            "type": "object",
            "required": ["source_node"],
            "properties": {
              "source_node": {"type": "string", "minLength": 1}
            }
          }
        ]
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "required": ["path", "purpose"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 1},
        "evidence_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  }
}
