{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS node artifact manifest",
  "type": "object",
  "required": ["schema_version", "node_id", "node_type", "owned_artifacts", "consumed_artifacts", "evidence_refs"],
  "properties": {
    "schema_version": {"const": "ts-artifact-manifest/2"},
    "node_id": {"type": "string", "minLength": 1},
    "node_type": {"enum": ["intake", "mechanism", "candidate_search", "validation", "audit"]},
    "mechanism_action": {"enum": ["propose", "compare", "revise", "evaluate"]},
    "candidate_kind": {"enum": ["transition_state", "endpoint_conformer", "intermediate", "crossing_point"]},
    "validation_scope": {"enum": ["tsfreq", "connectivity", "electronic_structure", "state_character", "thermochemistry", "method_robustness", "geometry_identity"]},
    "audit_scope": {"enum": ["transition_state", "elementary_step", "pathway", "study"]},
    "claim_layer": {"type": "string", "minLength": 1},
    "cross_node_consumption_reason": {"type": "string"},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "owned_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "consumed_artifacts": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/artifact_ref"},
          {
            "type": "object",
            "required": ["source_node"],
            "properties": {
              "source_node": {"type": "string", "minLength": 1}
            }
          }
        ]
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "required": ["path", "purpose"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 1},
        "evidence_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  }
}
