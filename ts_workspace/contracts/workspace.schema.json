{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "kernel_protocol", "created_at"],
  "properties": {
    "schema_version": {"const": "ts-workspace/4"},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9a-f]{24}$"},
    "kernel_protocol": {"const": "ts-research-kernel/4"},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 64}
  }
}
