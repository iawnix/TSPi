{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS hypotheses",
  "type": "object",
  "required": [
    "schema_version",
    "focus_hypothesis_id",
    "hypotheses",
    "accepted_facts",
    "refuted_hypotheses",
    "open_questions",
    "focus_pathway_id",
    "pathways"
  ],
  "properties": {
    "schema_version": {"const": "ts-hypotheses"},
    "focus_hypothesis_id": {"type": ["string", "null"]},
    "hypotheses": {"$ref": "mechanism.schema.json#/properties/hypotheses"},
    "accepted_facts": {"$ref": "mechanism.schema.json#/properties/accepted_facts"},
    "refuted_hypotheses": {"$ref": "mechanism.schema.json#/properties/refuted_hypotheses"},
    "open_questions": {"$ref": "mechanism.schema.json#/properties/open_questions"},
    "focus_pathway_id": {"type": ["string", "null"]},
    "pathways": {"$ref": "pathway.schema.json#/properties/pathways"},
    "audit_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "audit_scope", "status", "study_complete", "summary", "evidence_refs"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "audit_scope": {"enum": ["transition_state", "elementary_step", "pathway", "study"]},
          "status": {"enum": ["accepted", "not_accepted", "ambiguous"]},
          "study_complete": {"type": "boolean"},
          "hypothesis_ref": {"type": ["object", "null"]},
          "pathway_ref": {"type": ["object", "null"]},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "summary": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
