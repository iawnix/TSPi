{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS workspace decision draft input",
  "type": "object",
  "required": ["action", "rationale", "basis_refs", "payload"],
  "properties": {
    "action": {"enum": ["start_node", "update_workspace", "end_node"]},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 8000},
    "basis_refs": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "update_workspace"}}, "required": ["action"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "append_claim": {
                "oneOf": [
                  {"$ref": "claim_input.schema.json"},
                  {"type": "array", "minItems": 1, "items": {"$ref": "claim_input.schema.json"}}
                ]
              },
              "append_evidence": {
                "oneOf": [
                  {"$ref": "#/$defs/evidence_draft"},
                  {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_draft"}}
                ]
              },
              "append_evidence_event": {
                "oneOf": [
                  {"$ref": "evidence_event_input.schema.json"},
                  {"type": "array", "minItems": 1, "items": {"$ref": "evidence_event_input.schema.json"}}
                ]
              },
              "evaluate_gate": {
                "oneOf": [
                  {"$ref": "#/$defs/gate_draft"},
                  {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate_draft"}}
                ]
              },
              "link_operation": {
                "oneOf": [
                  {"$ref": "decision_v3.schema.json#/$defs/operation_link"},
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {"$ref": "decision_v3.schema.json#/$defs/operation_link"}
                  }
                ]
              },
              "set_focus_claim_refs": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^claim_[A-Za-z0-9_.-]+$"}
              },
              "append_provenance": {
                "oneOf": [
                  {"type": "object"},
                  {"type": "array", "minItems": 1, "items": {"type": "object"}}
                ]
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "evidence_draft": {
      "type": "object",
      "required": [
        "schema_version",
        "node_id",
        "kind",
        "evidence_tier",
        "summary",
        "facts",
        "artifact_refs",
        "provenance"
      ],
      "properties": {
        "schema_version": {"$ref": "evidence_v2.schema.json#/properties/schema_version"},
        "node_id": {"$ref": "evidence_v2.schema.json#/properties/node_id"},
        "kind": {"$ref": "evidence_v2.schema.json#/properties/kind"},
        "evidence_tier": {"$ref": "evidence_v2.schema.json#/properties/evidence_tier"},
        "summary": {"$ref": "evidence_v2.schema.json#/properties/summary"},
        "facts": {"$ref": "evidence_v2.schema.json#/properties/facts"},
        "artifact_refs": {"$ref": "evidence_v2.schema.json#/properties/artifact_refs"},
        "provenance": {"$ref": "evidence_v2.schema.json#/properties/provenance"},
        "supersedes_evidence_id": {"$ref": "evidence_v2.schema.json#/properties/supersedes_evidence_id"},
        "created_at": {"$ref": "evidence_v2.schema.json#/properties/created_at"}
      },
      "additionalProperties": false
    },
    "gate_draft": {
      "type": "object",
      "required": ["node_id", "gate", "evidence_refs", "target_ref"],
      "properties": {
        "node_id": {"$ref": "decision_v3.schema.json#/$defs/gate_request/properties/node_id"},
        "gate": {"$ref": "decision_v3.schema.json#/$defs/gate_request/properties/gate"},
        "evidence_refs": {"$ref": "decision_v3.schema.json#/$defs/gate_request/properties/evidence_refs"},
        "target_ref": {"$ref": "decision_v3.schema.json#/$defs/gate_request/properties/target_ref"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
