{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS evidence entry",
  "type": "object",
  "required": ["evidence_id", "kind", "role", "evidence_tier", "node_id", "summary"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "evidence_tier": {
      "enum": ["local_compute", "local_parse", "manual_observation", "literature", "user_provided", "hypothesis"]
    },
    "node_id": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "source_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_sha256": {"type": "string", "minLength": 1},
    "parser_name": {"type": "string", "minLength": 1},
    "parser_version": {"type": "string", "minLength": 1},
    "normal_termination": {"type": "boolean"},
    "supersedes_evidence_id": {"type": "string", "minLength": 1},
    "lifecycle_status": {"enum": ["withdrawn", "invalidated"]},
    "summary": {"type": "string", "minLength": 1},
    "quality": {"type": "object"},
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
