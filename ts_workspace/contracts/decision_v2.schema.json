{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS research decision",
  "type": "object",
  "required": ["schema_version", "action", "rationale", "payload"],
  "properties": {
    "schema_version": {"const": "ts-decision/2"},
    "decision_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "action": {"enum": ["init_workspace", "start_node", "end_node", "update_workspace", "ask_user", "stop"]},
    "rationale": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "base_revision": {"type": "string", "minLength": 1},
    "report_ref": {"$ref": "#/$defs/report_ref"},
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"enum": ["start_node", "end_node", "update_workspace"]}}},
      "then": {"required": ["report_ref", "base_revision"]}
    },
    {
      "if": {"properties": {"action": {"const": "start_node"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/start_payload"}}}
    },
    {
      "if": {"properties": {"action": {"const": "end_node"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/end_payload"}}}
    },
    {
      "if": {"properties": {"action": {"const": "update_workspace"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/update_payload"}}}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "report_ref": {
      "type": "object",
      "required": ["report_id", "workspace_root"],
      "properties": {
        "report_id": {"type": "string", "minLength": 1},
        "workspace_root": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "hypothesis_ref": {
      "type": "object",
      "required": ["hypothesis_id"],
      "properties": {
        "hypothesis_id": {"type": "string", "minLength": 1},
        "prediction_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "pathway_ref": {
      "type": "object",
      "required": ["pathway_id"],
      "properties": {
        "pathway_id": {"type": "string", "minLength": 1},
        "step_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "solution_ref": {
      "type": "object",
      "required": ["solution_id"],
      "properties": {
        "solution_id": {"type": "string", "minLength": 1},
        "summary": {"type": ["string", "null"]},
        "strategy": {"type": ["string", "null"]},
        "parent_solution_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "branch_context": {
      "type": "object",
      "required": ["relation", "from_node", "anchor_node"],
      "properties": {
        "relation": {"enum": ["continue_parent", "new_solution_branch", "new_hypothesis_branch", "new_pathway_branch", "recalculation_of"]},
        "from_node": {"type": "string", "minLength": 1},
        "anchor_node": {"type": "string", "minLength": 1},
        "changed_variable": {"type": "string", "minLength": 1},
        "reason_code": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "recalculation_ref": {
      "type": "object",
      "required": ["source_node", "changed_settings", "purpose"],
      "properties": {
        "source_node": {"type": "string", "minLength": 1},
        "source_intent_id": {"type": ["string", "null"]},
        "changed_settings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "purpose": {"enum": ["repair", "refinement", "method_robustness"]}
      },
      "additionalProperties": false
    },
    "repair_branch_anchor": {
      "type": "object",
      "required": ["node_id", "new_anchor_node", "reason_code"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "new_anchor_node": {"type": "string", "minLength": 1},
        "reason_code": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "repair_solution_ref": {
      "type": "object",
      "required": ["node_id", "solution_ref", "reason_code"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "solution_ref": {"$ref": "#/$defs/solution_ref"},
        "reason_code": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "start_payload": {
      "type": "object",
      "required": ["node_type", "objective"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "parent_node": {"type": ["string", "null"]},
        "node_type": {"enum": ["intake", "mechanism", "candidate_search", "validation", "audit"]},
        "objective": {"type": "string", "minLength": 1},
        "mechanism_action": {"enum": ["propose", "compare", "revise", "evaluate"]},
        "candidate_kind": {"enum": ["transition_state", "endpoint_conformer", "intermediate", "crossing_point"]},
        "validation_scope": {"enum": ["tsfreq", "connectivity", "electronic_structure", "state_character", "thermochemistry", "method_robustness", "geometry_identity"]},
        "audit_scope": {"enum": ["transition_state", "elementary_step", "pathway", "study"]},
        "attempt_kind": {"enum": ["primary", "recalculation"]},
        "recalculation_ref": {"$ref": "#/$defs/recalculation_ref"},
        "hypothesis_ref": {"$ref": "#/$defs/hypothesis_ref"},
        "proposed_hypothesis": {"type": "object"},
        "solution_ref": {"$ref": "#/$defs/solution_ref"},
        "pathway_ref": {"$ref": "#/$defs/pathway_ref"},
        "branch_context": {"$ref": "#/$defs/branch_context"},
        "expected_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "branch_context": {
                "type": "object",
                "properties": {"relation": {"const": "new_solution_branch"}},
                "required": ["relation"]
              }
            },
            "required": ["branch_context"]
          },
          "then": {"required": ["solution_ref"]}
        }
      ]
    },
    "section": {
      "type": "object",
      "required": ["summary", "evidence_refs"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "end_payload": {
      "type": "object",
      "required": ["node_id", "closure"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "closure": {
          "type": "object",
          "required": ["summary", "program", "open_questions"],
          "properties": {
            "summary": {"type": "string", "minLength": 1},
            "program": {
              "allOf": [
                {"$ref": "#/$defs/section"},
                {"type": "object", "required": ["outcome"], "properties": {"outcome": {"enum": ["success", "failure", "not_run"]}, "error_class": {"type": ["string", "null"]}}}
              ]
            },
            "intake": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["ready", "needs_input"]}}, "additionalProperties": true},
            "hypothesis": {
              "allOf": [
                {"$ref": "#/$defs/section"},
                {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["supported", "unsupported", "ambiguous"]}, "hypothesis_ref": {"$ref": "#/$defs/hypothesis_ref"}, "revision": {"type": ["object", "null"]}}}
              ]
            },
            "audit": {
              "allOf": [
                {"$ref": "#/$defs/section"},
                {"type": "object", "required": ["status", "study_complete"], "properties": {"status": {"enum": ["accepted", "not_accepted", "ambiguous"]}, "study_complete": {"type": "boolean"}}}
              ]
            },
            "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "update_payload": {
      "type": "object",
      "properties": {
        "append_evidence": {
          "oneOf": [
            {"$ref": "evidence.schema.json"},
            {"type": "array", "minItems": 1, "items": {"$ref": "evidence.schema.json"}}
          ]
        },
        "append_provenance": {
          "oneOf": [
            {"type": "object"},
            {"type": "array", "minItems": 1, "items": {"type": "object"}}
          ]
        },
        "repair_branch_anchor": {
          "oneOf": [
            {"$ref": "#/$defs/repair_branch_anchor"},
            {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repair_branch_anchor"}}
          ]
        },
        "repair_solution_ref": {
          "oneOf": [
            {"$ref": "#/$defs/repair_solution_ref"},
            {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repair_solution_ref"}}
          ]
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    }
  }
}
