{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS workspace decision v3",
  "type": "object",
  "required": ["schema_version", "decision_id", "action", "rationale", "basis_refs", "report_ref", "base_revision", "payload"],
  "properties": {
    "schema_version": {"const": "ts-decision/3"},
    "decision_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "maxLength": 128},
    "action": {"enum": ["init_workspace", "start_node", "update_workspace", "end_node"]},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 8000},
    "basis_refs": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "report_ref": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["report_id", "workspace_root"],
          "properties": {
            "report_id": {"type": "string", "minLength": 1},
            "workspace_root": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "base_revision": {"type": ["string", "null"]},
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "init_workspace"}}, "required": ["action"]},
      "then": {
        "properties": {
          "report_ref": {"type": "null"},
          "base_revision": {"type": "null"},
          "payload": {"type": "object", "maxProperties": 0}
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "start_node"}}, "required": ["action"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["parent_node", "objective", "tags", "claim_refs"],
            "properties": {
              "node_id": {"type": ["string", "null"], "maxLength": 128},
              "parent_node": {"type": ["string", "null"], "maxLength": 128},
              "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
              "tags": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]*$"}},
              "claim_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^claim_[A-Za-z0-9_.-]+$"}}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "update_workspace"}}, "required": ["action"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "append_claim": {"oneOf": [{"$ref": "claim_input.schema.json"}, {"type": "array", "minItems": 1, "items": {"$ref": "claim_input.schema.json"}}]},
              "append_evidence": {"oneOf": [{"$ref": "evidence_v2.schema.json"}, {"type": "array", "minItems": 1, "items": {"$ref": "evidence_v2.schema.json"}}]},
              "append_evidence_event": {"oneOf": [{"$ref": "evidence_event_input.schema.json"}, {"type": "array", "minItems": 1, "items": {"$ref": "evidence_event_input.schema.json"}}]},
              "evaluate_gate": {
                "oneOf": [
                  {"$ref": "#/$defs/gate_request"},
                  {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate_request"}}
                ]
              },
              "link_operation": {
                "oneOf": [
                  {"$ref": "#/$defs/operation_link"},
                  {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation_link"}}
                ]
              },
              "set_focus_claim_refs": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^claim_[A-Za-z0-9_.-]+$"}
              },
              "append_provenance": {"oneOf": [{"type": "object"}, {"type": "array", "minItems": 1, "items": {"type": "object"}}]}
            },
            "additionalProperties": false,
            "minProperties": 1
          }
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "end_node"}}, "required": ["action"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["node_id", "result"],
            "properties": {
              "node_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "result": {"$ref": "node_result.schema.json"}
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "$defs": {
    "gate_request": {
      "type": "object",
      "required": ["gate_result_id", "node_id", "gate", "evidence_refs", "target_ref"],
      "properties": {
        "gate_result_id": {"type": "string", "pattern": "^gr_[A-Za-z0-9_.-]+$"},
        "node_id": {"type": "string", "minLength": 1},
        "gate": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ev_[A-Za-z0-9_.-]+$"}},
        "target_ref": {"type": ["string", "null"], "maxLength": 256}
      },
      "additionalProperties": false
    },
    "operation_link": {
      "type": "object",
      "required": ["node_id", "operation_ref"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "operation_ref": {"type": "string", "minLength": 1, "maxLength": 4096}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
