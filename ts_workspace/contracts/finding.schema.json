{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "$defs": {"finding_id": {"type": "string", "pattern": "^fnd_[1-9][0-9]*$"}},
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "finding_id", "finding_type", "severity", "status", "statement",
    "claim_refs", "act_refs", "basis_observation_refs", "resolution", "created_by_decision", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "ts-finding/1"},
    "finding_id": {"$ref": "#/$defs/finding_id"},
    "finding_type": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$", "maxLength": 128},
    "severity": {"enum": ["blocking", "warning", "informational"]},
    "status": {"enum": ["open", "resolved", "accepted_risk", "superseded"]},
    "statement": {"type": "string", "minLength": 1, "maxLength": 12000},
    "claim_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "claim.schema.json#/$defs/claim_id"}},
    "act_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "research_act.schema.json#/$defs/act_id"}},
    "basis_observation_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "observation.schema.json#/$defs/observation_id"}},
    "resolution": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "summary", "basis_observation_refs", "decision_id", "resolved_at"],
          "properties": {
            "status": {"enum": ["resolved", "accepted_risk", "superseded"]},
            "summary": {"type": "string", "minLength": 1, "maxLength": 8000},
            "basis_observation_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "observation.schema.json#/$defs/observation_id"}},
            "decision_id": {"$ref": "decision.schema.json#/$defs/decision_id"},
            "resolved_at": {"type": "string", "minLength": 1, "maxLength": 64}
          }
        }
      ]
    },
    "created_by_decision": {"$ref": "decision.schema.json#/$defs/decision_id"},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 64}
  }
}
