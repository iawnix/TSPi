{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS research graph v3",
  "type": "object",
  "required": ["schema_version", "nodes", "edges", "open_nodes", "branch_events", "accepted_refs", "provenance"],
  "properties": {
    "schema_version": {"const": "ts-research-state/3"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "parent_node", "objective", "state", "tags"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "parent_node": {"type": ["string", "null"]},
          "objective": {"type": "string", "minLength": 1},
          "state": {"enum": ["open", "closed", "stopped"]},
          "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "outcome": {"enum": ["completed", "inconclusive", "blocked", "stopped"]},
          "closed_at": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["parent_node", "child_node"],
        "properties": {
          "parent_node": {"type": "string", "minLength": 1},
          "child_node": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "open_nodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "branch_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "parent_node", "decision_id", "created_at"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "parent_node": {"type": ["string", "null"]},
          "decision_id": {"type": "string", "minLength": 1},
          "created_at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    },
    "accepted_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "provenance": {"type": "array", "items": {"type": "object"}
    }
  },
  "additionalProperties": false
}
