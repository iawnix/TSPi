{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS tree",
  "type": "object",
  "required": ["schema_version", "nodes", "edges", "current_node", "branch_events"],
  "properties": {
    "schema_version": {"const": "ts-tree"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "parent_node", "phase", "lifecycle", "hypothesis"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "parent_node": {"type": ["string", "null"]},
          "phase": {
            "enum": ["preflight", "endpoint", "rp_conformer_generation", "candidate_generation", "tsfreq_validation", "connectivity_validation", "accepted_audit", "pathway_audit"]
          },
          "lifecycle": {"enum": ["running", "closed", "stopped"]},
          "hypothesis": {"type": "string", "minLength": 1},
          "hypothesis_ref": {
            "anyOf": [{"$ref": "mechanism.schema.json#/$defs/hypothesis_ref"}, {"type": "null"}]
          },
          "solution_ref": {
            "anyOf": [
              {
                "type": "object",
                "required": ["solution_id"],
                "properties": {
                  "solution_id": {"type": "string", "minLength": 1},
                  "summary": {"type": ["string", "null"]},
                  "strategy": {"type": ["string", "null"]},
                  "parent_solution_id": {"type": ["string", "null"]}
                },
                "additionalProperties": true
              },
              {"type": "null"}
            ]
          },
          "branch_context": {
            "anyOf": [{"$ref": "#/$defs/branch_context"}, {"type": "null"}]
          },
          "closed_at": {"type": "string"},
          "program_status": {"enum": ["completed", "failed", "stopped", "not_run"]},
          "claim_verdict": {"enum": ["supported", "refuted", "inconclusive", "not_evaluated"]}
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["parent_node", "child_node"],
        "properties": {
          "parent_node": {"type": "string", "minLength": 1},
          "child_node": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "current_node": {"type": ["string", "null"]},
    "branch_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "event_state", "relation", "from_node", "anchor_node", "new_node", "parent_node", "is_rebased"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "event_state": {"enum": ["active", "resolved", "superseded"]},
          "relation": {
            "enum": ["continue_parent", "new_solution_branch", "new_hypothesis_branch", "new_pathway_branch", "administrative_followup"]
          },
          "from_node": {"type": "string", "minLength": 1},
          "anchor_node": {"type": "string", "minLength": 1},
          "new_node": {"type": "string", "minLength": 1},
          "parent_node": {"type": "string", "minLength": 1},
          "is_rebased": {"type": "boolean"},
          "reason_code": {"type": "string", "minLength": 1},
          "changed_variable": {"type": "string", "minLength": 1},
          "target_hypothesis_ref": {
            "anyOf": [{"$ref": "mechanism.schema.json#/$defs/hypothesis_ref"}, {"type": "null"}]
          },
          "target_solution_ref": {
            "anyOf": [
              {
                "type": "object",
                "required": ["solution_id"],
                "properties": {
                  "solution_id": {"type": "string", "minLength": 1},
                  "summary": {"type": ["string", "null"]},
                  "strategy": {"type": ["string", "null"]},
                  "parent_solution_id": {"type": ["string", "null"]}
                },
                "additionalProperties": true
              },
              {"type": "null"}
            ]
          },
          "rationale": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "created_by_decision": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "branch_context": {
      "type": "object",
      "required": ["relation", "from_node", "anchor_node"],
      "properties": {
        "relation": {
          "enum": ["continue_parent", "new_solution_branch", "new_hypothesis_branch", "new_pathway_branch", "administrative_followup"]
        },
        "from_node": {"type": "string", "minLength": 1},
        "anchor_node": {"type": "string", "minLength": 1},
        "reason_code": {"type": "string", "minLength": 1},
        "changed_variable": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    }
  }
}
