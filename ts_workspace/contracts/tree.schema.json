{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS tree",
  "type": "object",
  "required": ["schema_version", "nodes", "edges", "current_node", "branch_events"],
  "properties": {
    "schema_version": {"const": "ts-tree"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "parent_node", "node_type", "objective", "lifecycle"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "parent_node": {"type": ["string", "null"]},
          "node_type": {"enum": ["intake", "mechanism", "candidate_search", "validation", "audit"]},
          "objective": {"type": "string", "minLength": 1},
          "mechanism_action": {"enum": ["propose", "compare", "revise", "evaluate"]},
          "candidate_kind": {"enum": ["transition_state", "endpoint_conformer", "intermediate", "crossing_point"]},
          "validation_scope": {"enum": ["tsfreq", "connectivity", "electronic_structure", "state_character", "thermochemistry", "method_robustness", "geometry_identity"]},
          "audit_scope": {"enum": ["transition_state", "elementary_step", "pathway", "study"]},
          "attempt_kind": {"enum": ["primary", "recalculation"]},
          "recalculation_ref": {"type": ["object", "null"]},
          "lifecycle": {"enum": ["running", "closed", "stopped"]},
          "hypothesis_ref": {
            "anyOf": [{"$ref": "mechanism.schema.json#/$defs/hypothesis_ref"}, {"type": "null"}]
          },
          "solution_ref": {
            "anyOf": [
              {
                "type": "object",
                "required": ["solution_id"],
                "properties": {
                  "solution_id": {"type": "string", "minLength": 1},
                  "summary": {"type": ["string", "null"]},
                  "strategy": {"type": ["string", "null"]},
                  "parent_solution_id": {"type": ["string", "null"]}
                },
                "additionalProperties": true
              },
              {"type": "null"}
            ]
          },
          "pathway_ref": {"anyOf": [{"$ref": "#/$defs/pathway_ref"}, {"type": "null"}]},
          "branch_context": {
            "anyOf": [{"$ref": "#/$defs/branch_context"}, {"type": "null"}]
          },
          "closed_at": {"type": "string"},
          "program_outcome": {"enum": ["success", "failure", "not_run"]},
          "hypothesis_status": {"enum": ["supported", "unsupported", "ambiguous"]},
          "audit_status": {"enum": ["accepted", "not_accepted", "ambiguous"]},
          "intake_status": {"enum": ["ready", "needs_input"]},
          "study_complete": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["parent_node", "child_node"],
        "properties": {
          "parent_node": {"type": "string", "minLength": 1},
          "child_node": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "current_node": {"type": ["string", "null"]},
    "branch_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "event_state", "relation", "from_node", "anchor_node", "new_node", "parent_node", "is_rebased"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "event_state": {"enum": ["active", "resolved", "superseded"]},
          "relation": {
            "enum": ["continue_parent", "new_solution_branch", "new_hypothesis_branch", "new_pathway_branch", "recalculation_of"]
          },
          "from_node": {"type": "string", "minLength": 1},
          "anchor_node": {"type": "string", "minLength": 1},
          "new_node": {"type": "string", "minLength": 1},
          "parent_node": {"type": "string", "minLength": 1},
          "is_rebased": {"type": "boolean"},
          "reason_code": {"type": "string", "minLength": 1},
          "changed_variable": {"type": "string", "minLength": 1},
          "target_hypothesis_ref": {
            "anyOf": [{"$ref": "mechanism.schema.json#/$defs/hypothesis_ref"}, {"type": "null"}]
          },
          "target_solution_ref": {
            "anyOf": [
              {
                "type": "object",
                "required": ["solution_id"],
                "properties": {
                  "solution_id": {"type": "string", "minLength": 1},
                  "summary": {"type": ["string", "null"]},
                  "strategy": {"type": ["string", "null"]},
                  "parent_solution_id": {"type": ["string", "null"]}
                },
                "additionalProperties": true
              },
              {"type": "null"}
            ]
          },
          "target_pathway_ref": {"anyOf": [{"$ref": "#/$defs/pathway_ref"}, {"type": "null"}]},
          "rationale": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "created_by_decision": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "branch_context": {
      "type": "object",
      "required": ["relation", "from_node", "anchor_node"],
      "properties": {
        "relation": {
          "enum": ["continue_parent", "new_solution_branch", "new_hypothesis_branch", "new_pathway_branch", "recalculation_of"]
        },
        "from_node": {"type": "string", "minLength": 1},
        "anchor_node": {"type": "string", "minLength": 1},
        "reason_code": {"type": "string", "minLength": 1},
        "changed_variable": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "pathway_ref": {
      "type": "object",
      "required": ["pathway_id"],
      "properties": {
        "pathway_id": {"type": "string", "minLength": 1},
        "step_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
