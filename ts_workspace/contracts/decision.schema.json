{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS decision",
  "type": "object",
  "required": ["schema_version", "action", "rationale", "payload"],
  "properties": {
    "schema_version": {"const": "ts-decision"},
    "decision_id": {"type": "string", "minLength": 1},
    "action": {
      "enum": ["init_workspace", "start_node", "propose_hypothesis", "end_node", "update_workspace", "ask_user", "stop"]
    },
    "rationale": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "report_ref": {
      "type": "object",
      "required": ["report_id", "workspace_root"],
      "properties": {
        "report_id": {"type": "string", "minLength": 1},
        "workspace_root": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "payload": {
      "type": "object",
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "parent_node": {"type": ["string", "null"]},
        "phase": {
          "enum": ["endpoint", "candidate_generation", "tsfreq_validation", "connectivity_validation", "accepted_audit", "pathway_audit"]
        },
        "hypothesis": {"type": "string", "minLength": 1},
        "hypothesis_ref": {"$ref": "mechanism.schema.json#/$defs/hypothesis_ref"},
        "solution_ref": {"$ref": "#/$defs/solution_ref"},
        "branch_context": {"$ref": "#/$defs/branch_context"},
        "initial_mechanism_hypothesis": {"$ref": "mechanism.schema.json#/$defs/mechanism_hypothesis_input"},
        "proposed_hypothesis": {"$ref": "mechanism.schema.json#/$defs/mechanism_hypothesis_input"},
        "proposal_context": {"$ref": "#/$defs/proposal_context"},
        "expected_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "pathway_ref": {"$ref": "#/$defs/pathway_ref"},
        "closure": {"$ref": "#/$defs/closure"},
        "append_evidence": {
          "anyOf": [
            {"$ref": "evidence.schema.json"},
            {"type": "array", "items": {"$ref": "evidence.schema.json"}}
          ]
        },
        "append_knowledge": {
          "type": ["string", "object", "array"]
        },
        "append_provenance": {
          "anyOf": [
            {"type": "object"},
            {"type": "array", "items": {"type": "object"}}
          ]
        },
        "repair_branch_anchor": {
          "anyOf": [
            {"$ref": "#/$defs/branch_anchor_repair"},
            {"type": "array", "items": {"$ref": "#/$defs/branch_anchor_repair"}}
          ]
        },
        "question": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"enum": ["start_node", "propose_hypothesis", "end_node", "update_workspace"]}}},
      "then": {"required": ["report_ref"]}
    },
    {
      "if": {"properties": {"action": {"const": "propose_hypothesis"}}},
      "then": {
        "properties": {
          "payload": {"required": ["proposed_hypothesis", "proposal_context"]}
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "start_node"}}},
      "then": {
        "properties": {
          "payload": {"required": ["phase", "hypothesis"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {"const": "start_node"},
          "payload": {
            "properties": {
              "phase": {"const": "pathway_audit"}
            },
            "required": ["phase"]
          }
        },
        "required": ["action", "payload"]
      },
      "then": {
        "properties": {
          "payload": {"required": ["pathway_ref"]}
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "end_node"}}},
      "then": {
        "properties": {
          "payload": {"required": ["node_id", "closure"]}
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "update_workspace"}}},
      "then": {
        "properties": {
          "payload": {
            "anyOf": [
              {"required": ["append_evidence"]},
              {"required": ["append_knowledge"]},
              {"required": ["append_provenance"]},
              {"required": ["repair_branch_anchor"]}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "ask_user"}}},
      "then": {"properties": {"payload": {"required": ["question"]}}}
    },
    {
      "if": {"properties": {"action": {"const": "stop"}}},
      "then": {"properties": {"payload": {"required": ["reason"]}}}
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "pathway_ref": {
      "type": "object",
      "required": ["pathway_id", "step_id"],
      "properties": {
        "pathway_id": {"type": "string", "minLength": 1},
        "step_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "solution_ref": {
      "type": "object",
      "required": ["solution_id"],
      "properties": {
        "solution_id": {"type": "string", "minLength": 1},
        "summary": {"type": ["string", "null"]},
        "strategy": {"type": ["string", "null"]},
        "parent_solution_id": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "branch_context": {
      "type": "object",
      "required": ["relation", "from_node", "anchor_node"],
      "properties": {
        "relation": {
          "enum": ["continue_parent", "new_solution_branch", "new_hypothesis_branch", "new_pathway_branch"]
        },
        "from_node": {"type": "string", "minLength": 1},
        "anchor_node": {"type": "string", "minLength": 1},
        "changed_variable": {"type": "string", "minLength": 1},
        "reason_code": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "proposal_context": {
      "type": "object",
      "required": ["kind", "from_node", "anchor_node", "changed_variable", "reason_code"],
      "properties": {
        "kind": {"enum": ["initial", "alternative"]},
        "from_node": {"type": "string", "minLength": 1},
        "anchor_node": {"type": "string", "minLength": 1},
        "changed_variable": {"type": "string", "minLength": 1},
        "reason_code": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "branch_anchor_repair": {
      "type": "object",
      "required": ["node_id", "new_anchor_node", "reason_code"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "new_anchor_node": {"type": "string", "minLength": 1},
        "reason_code": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "closure": {
      "type": "object",
      "required": ["program_status", "claim_verdict", "program", "mechanism"],
      "properties": {
        "program_status": {"enum": ["completed", "failed", "stopped", "not_run"]},
        "claim_verdict": {"enum": ["supported", "refuted", "inconclusive", "not_evaluated"]},
        "program": {"$ref": "#/$defs/closure_section"},
        "mechanism": {
          "allOf": [
            {"$ref": "#/$defs/closure_section"},
            {
              "type": "object",
              "properties": {
                "hypothesis_ref": {"$ref": "mechanism.schema.json#/$defs/hypothesis_ref"},
                "impact_scope": {"enum": ["solution_only", "prediction", "pathway_step", "hypothesis"]},
                "revision": {"type": ["object", "null"]}
              }
            }
          ]
        },
        "implication": {"type": "string"},
        "open_questions": {"type": "array"}
      },
      "additionalProperties": true
    },
    "closure_section": {
      "type": "object",
      "required": ["summary", "evidence_refs"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    }
  }
}
