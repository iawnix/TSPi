{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS evidence lifecycle event input",
  "type": "object",
  "required": ["event_id", "evidence_id", "state", "reason"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^ee_[A-Za-z0-9_.-]+$", "maxLength": 256},
    "evidence_id": {"type": "string", "pattern": "^ev_[A-Za-z0-9_.-]+$", "maxLength": 256},
    "state": {"enum": ["withdrawn", "invalidated"]},
    "reason": {"type": "string", "minLength": 1, "maxLength": 4000}
  },
  "additionalProperties": false
}
