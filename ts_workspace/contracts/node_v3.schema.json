{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS research node v3",
  "type": "object",
  "required": [
    "schema_version",
    "node_id",
    "parent_node",
    "objective",
    "state",
    "tags",
    "claim_refs",
    "operation_refs",
    "evidence_refs",
    "gate_result_refs",
    "created_by_decision",
    "opened_at",
    "artifacts",
    "result"
  ],
  "properties": {
    "schema_version": {"const": "ts-node/3"},
    "node_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "maxLength": 128},
    "parent_node": {"type": ["string", "null"], "maxLength": 128},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "state": {"enum": ["open", "closed", "stopped"]},
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]*$", "maxLength": 128}
    },
    "claim_refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "operation_refs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "gate_result_refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "created_by_decision": {"type": "string", "minLength": 1, "maxLength": 256},
    "opened_at": {"type": "string", "format": "date-time"},
    "closed_at": {"type": "string", "format": "date-time"},
    "ended_by_decision": {"type": "string", "minLength": 1, "maxLength": 256},
    "artifacts": {"type": "object"},
    "result": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "node_result.schema.json"}
      ]
    }
  },
  "additionalProperties": false
}
