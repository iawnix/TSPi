{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision_draft.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["rationale", "basis_refs", "operations"],
  "properties": {
    "rationale": {"type": "string", "minLength": 1, "maxLength": 12000},
    "basis_refs": {"type": "array", "uniqueItems": true, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {"op": {"type": "string", "minLength": 1, "maxLength": 64}}
      }
    }
  }
}
