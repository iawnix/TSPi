{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS research node result",
  "type": "object",
  "required": ["outcome", "summary", "claim_updates", "audit", "open_questions"],
  "properties": {
    "outcome": {"enum": ["completed", "inconclusive", "blocked", "stopped"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 8000},
    "claim_updates": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["claim_ref", "verdict", "summary", "evidence_refs", "gate_result_refs"],
        "properties": {
          "claim_ref": {"type": "string", "minLength": 1, "maxLength": 256},
          "verdict": {"enum": ["supported", "contradicted", "inconclusive"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
          "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "gate_result_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "audit": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["policy", "verdict", "target_ref", "gate_result_refs", "study_complete", "summary"],
          "properties": {
            "policy": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[0-9]+$"},
            "verdict": {"enum": ["accepted", "not_accepted", "inconclusive"]},
            "target_ref": {"type": "string", "minLength": 1, "maxLength": 256},
            "gate_result_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "study_complete": {"type": "boolean"},
            "summary": {"type": "string", "minLength": 1, "maxLength": 4000}
          },
          "additionalProperties": false
        }
      ]
    },
    "open_questions": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    }
  },
  "additionalProperties": false
}
