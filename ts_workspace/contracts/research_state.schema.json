{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS research state",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "hypothesis_contract_version",
    "accepted_ts_refs",
    "provenance",
    "nodes",
    "edges",
    "current_node",
    "branch_events"
  ],
  "properties": {
    "schema_version": {"const": "ts-research-state"},
    "created_at": {"type": "string", "minLength": 1},
    "hypothesis_contract_version": {"type": "string", "minLength": 1},
    "accepted_ts_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "provenance": {"type": "array"},
    "nodes": {"$ref": "tree.schema.json#/properties/nodes"},
    "edges": {"$ref": "tree.schema.json#/properties/edges"},
    "current_node": {"$ref": "tree.schema.json#/properties/current_node"},
    "branch_events": {"$ref": "tree.schema.json#/properties/branch_events"}
  },
  "additionalProperties": false
}
