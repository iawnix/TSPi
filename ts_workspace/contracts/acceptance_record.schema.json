{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acceptance_record.schema.json",
  "$defs": {"acceptance_id": {"type": "string", "pattern": "^acc_[1-9][0-9]*$"}},
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "acceptance_id", "claim_ref", "claim_snapshot", "claim_digest", "profile_ref", "profile_digest",
    "validation_spec_refs", "validation_spec_digests", "validation_result_refs", "validation_result_digests",
    "finding_snapshot", "finding_snapshot_digest", "summary", "decision_id", "accepted_at", "acceptance_digest"
  ],
  "properties": {
    "schema_version": {"const": "ts-acceptance-record/1"},
    "acceptance_id": {"$ref": "#/$defs/acceptance_id"},
    "claim_ref": {"$ref": "claim.schema.json#/$defs/claim_id"},
    "claim_snapshot": {"$ref": "claim.schema.json"},
    "claim_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "version"],
      "properties": {
        "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "maxLength": 128},
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "maxLength": 64}
      }
    },
    "profile_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "validation_spec_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "validation_spec.schema.json#/$defs/spec_id"}},
    "validation_spec_digests": {
      "type": "object",
      "propertyNames": {"pattern": "^gsp_[1-9][0-9]*$"},
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "validation_result_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "validation_result.schema.json#/$defs/result_id"}},
    "validation_result_digests": {
      "type": "object",
      "propertyNames": {"pattern": "^val_[1-9][0-9]*$"},
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "finding_snapshot": {"type": "array", "items": {"$ref": "finding.schema.json"}},
    "finding_snapshot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 12000},
    "decision_id": {"$ref": "decision.schema.json#/$defs/decision_id"},
    "accepted_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "acceptance_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
