{
  "schema_version": "ts-gate-policies/1",
  "evaluators": {
    "tsfreq": {
      "policy": "tsfreq/2",
      "allowed_tiers": ["local_parse"],
      "requirements": [
        {"path": "normal_termination", "op": "equals", "value": true},
        {"path": "stationary_point", "op": "equals", "value": true},
        {"path": "final_convergence_satisfied", "op": "equals", "value": true},
        {"path": "imaginary_frequency_count", "op": "equals", "value": 1},
        {"path": "route_match", "op": "equals", "value": true}
      ]
    },
    "mode_assignment": {
      "policy": "mode-assignment/1",
      "allowed_tiers": ["local_parse", "manual_observation"],
      "requirements": [
        {"path": "mode_matches_declared_reaction_coordinate", "op": "equals", "value": true}
      ]
    },
    "connectivity": {
      "policy": "connectivity/2",
      "allowed_tiers": ["local_parse"],
      "requirements": [
        {"path": "normal_termination", "op": "equals", "value": true},
        {"path": "strict_irc_complete", "op": "equals", "value": true},
        {"path": "irc_program_failures", "op": "empty"},
        {"path": "irc_directions.forward.normal_termination", "op": "equals", "value": true},
        {"path": "irc_directions.forward.assignment", "op": "nonempty"},
        {"path": "irc_directions.reverse.normal_termination", "op": "equals", "value": true},
        {"path": "irc_directions.reverse.assignment", "op": "nonempty"}
      ]
    },
    "stereochemistry": {
      "policy": "stereochemistry/1",
      "allowed_tiers": ["local_parse", "manual_observation"],
      "requirements": [
        {"path": "stereochemistry_matched", "op": "equals", "value": true},
        {"path": "stereochemical_mismatches", "op": "empty"}
      ]
    },
    "endpoint_identity": {
      "policy": "endpoint-identity/1",
      "allowed_tiers": ["local_parse", "manual_observation"],
      "requirements": [{"path": "identity_supported", "op": "equals", "value": true}]
    },
    "intermediate_identity": {
      "policy": "intermediate-identity/1",
      "allowed_tiers": ["local_parse", "manual_observation"],
      "requirements": [{"path": "identity_supported", "op": "equals", "value": true}]
    },
    "electronic_structure": {
      "policy": "electronic-structure/1",
      "allowed_tiers": ["local_parse"],
      "requirements": [
        {"path": "normal_termination", "op": "equals", "value": true},
        {"path": "electronic_structure_supported", "op": "equals", "value": true}
      ]
    },
    "state_character": {
      "policy": "state-character/1",
      "allowed_tiers": ["local_parse"],
      "requirements": [
        {"path": "normal_termination", "op": "equals", "value": true},
        {"path": "state_character_supported", "op": "equals", "value": true}
      ]
    },
    "shared_basin_consistency": {
      "policy": "shared-basin-consistency/1",
      "allowed_tiers": ["local_parse", "manual_observation"],
      "requirements": [{"path": "shared_basin_consistent", "op": "equals", "value": true}]
    },
    "method_robustness": {
      "policy": "method-robustness/1",
      "allowed_tiers": ["local_parse"],
      "requirements": [{"path": "method_robustness_supported", "op": "equals", "value": true}]
    },
    "thermochemistry": {
      "policy": "thermochemistry/1",
      "allowed_tiers": ["local_parse"],
      "requirements": [{"path": "thermochemistry_complete", "op": "equals", "value": true}]
    },
    "pathway_audit": {
      "policy": "pathway-audit/1",
      "allowed_tiers": ["local_parse", "manual_observation"],
      "requirements": [{"path": "strict_pathway_decision", "op": "one_of", "value": ["accepted", "pathway_not_accepted"]}]
    }
  },
  "audit_policies": {
    "accepted-ts/2": {
      "required_gates": ["tsfreq", "connectivity"],
      "optional_gates": [
        "mode_assignment",
        "stereochemistry",
        "endpoint_identity",
        "intermediate_identity",
        "electronic_structure",
        "state_character",
        "shared_basin_consistency",
        "method_robustness",
        "thermochemistry"
      ]
    },
    "accepted-pathway/1": {
      "required_gates": ["pathway_audit"],
      "optional_gates": [
        "endpoint_identity",
        "intermediate_identity",
        "electronic_structure",
        "state_character",
        "shared_basin_consistency",
        "method_robustness",
        "thermochemistry"
      ]
    }
  }
}
