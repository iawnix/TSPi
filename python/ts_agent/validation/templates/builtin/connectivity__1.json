{
  "schema_version": "ts-gate-template/1",
  "template_id": "connectivity",
  "version": "1",
  "title": "Bidirectional reaction-path connectivity",
  "parameters": {
    "subject_ref": {"type": "string", "required": true},
    "reactant_ref": {"type": "string", "required": true},
    "product_ref": {"type": "string", "required": true}
  },
  "definition": {
    "checks": [
      {"check_id": "normal_termination", "predicate": "observation.equals", "parameters": {"selector": {"concept_id": "program.normal_termination", "subject_ref": "${subject_ref}"}, "expected": true}, "blocking": true},
      {"check_id": "path_complete", "predicate": "observation.equals", "parameters": {"selector": {"concept_id": "reaction_path.bidirectional_complete", "subject_ref": "${subject_ref}"}, "expected": true}, "blocking": true},
      {"check_id": "no_program_failures", "predicate": "observation.empty", "parameters": {"selector": {"concept_id": "reaction_path.program_failures", "subject_ref": "${subject_ref}"}}, "blocking": true},
      {"check_id": "reactant_endpoint", "predicate": "observation.equals", "parameters": {"selector": {"concept_id": "reaction_path.endpoint_assignment", "subject_ref": "${subject_ref}", "qualifiers": {"direction": "reverse"}}, "expected": "${reactant_ref}"}, "blocking": true},
      {"check_id": "product_endpoint", "predicate": "observation.equals", "parameters": {"selector": {"concept_id": "reaction_path.endpoint_assignment", "subject_ref": "${subject_ref}", "qualifiers": {"direction": "forward"}}, "expected": "${product_ref}"}, "blocking": true}
    ],
    "success_policy": {"mode": "all_blocking"}
  }
}
