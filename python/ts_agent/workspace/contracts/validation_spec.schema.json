{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation_spec.schema.json",
  "$defs": {"spec_id": {"type": "string", "pattern": "^gsp_[1-9][0-9]*$"}},
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "spec_id", "target_claim_ref", "dimension", "title", "template_ref",
    "template_digest", "predicate_registry_digest", "checks", "success_policy", "created_by_node",
    "created_by_decision", "frozen_at", "spec_digest"
  ],
  "properties": {
    "schema_version": {"const": "ts-gate-spec/2"},
    "spec_id": {"$ref": "#/$defs/spec_id"},
    "target_claim_ref": {"$ref": "claim.schema.json#/$defs/claim_id"},
    "dimension": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$", "maxLength": 128},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "template_ref": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["template_id", "version"],
          "properties": {
            "template_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "maxLength": 128},
            "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "maxLength": 64}
          }
        }
      ]
    },
    "template_digest": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]},
    "predicate_registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "predicate", "predicate_version", "parameters", "blocking"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$", "maxLength": 128},
          "predicate": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$", "maxLength": 128},
          "predicate_version": {"type": "string", "minLength": 1, "maxLength": 64},
          "parameters": {"type": "object", "maxProperties": 64},
          "blocking": {"type": "boolean"}
        }
      }
    },
    "success_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"enum": ["all", "all_blocking"]}}
    },
    "created_by_node": {"$ref": "research_node.schema.json#/$defs/node_id"},
    "created_by_decision": {"$ref": "decision.schema.json#/$defs/decision_id"},
    "frozen_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "spec_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
