{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation_result.schema.json",
  "$defs": {
    "result_id": {"type": "string", "pattern": "^result_[1-9][0-9]*$"},
    "verdict": {"enum": ["pass", "fail", "inconclusive", "error"]}
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result_id", "proof_ref", "proof_digest", "target_claim_ref", "dimension",
    "verdict", "observation_refs", "observation_digests", "check_results", "evaluated_by_node",
    "evaluated_by_decision", "evaluated_at", "result_digest"
  ],
  "properties": {
    "schema_version": {"const": "ts-validation-result/3"},
    "result_id": {"$ref": "#/$defs/result_id"},
    "proof_ref": {"$ref": "proof_spec.schema.json#/$defs/proof_id"},
    "proof_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "target_claim_ref": {"$ref": "claim.schema.json#/$defs/claim_id"},
    "dimension": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$", "maxLength": 128},
    "verdict": {"$ref": "#/$defs/verdict"},
    "observation_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "observation.schema.json#/$defs/observation_id"}},
    "observation_digests": {
      "type": "object",
      "propertyNames": {"pattern": "^obs_[1-9][0-9]*$"},
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "check_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "predicate", "predicate_version", "blocking", "verdict", "observation_refs", "message"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "predicate": {"type": "string", "minLength": 1, "maxLength": 128},
          "predicate_version": {"type": "string", "minLength": 1, "maxLength": 64},
          "blocking": {"type": "boolean"},
          "verdict": {"$ref": "#/$defs/verdict"},
          "observation_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "observation.schema.json#/$defs/observation_id"}},
          "message": {"type": "string", "maxLength": 2000}
        }
      }
    },
    "evaluated_by_node": {"$ref": "research_node.schema.json#/$defs/node_id"},
    "evaluated_by_decision": {"$ref": "decision.schema.json#/$defs/decision_id"},
    "evaluated_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "result_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
