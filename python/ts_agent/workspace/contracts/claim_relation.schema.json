{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim_relation.schema.json",
  "$defs": {"relation_id": {"type": "string", "pattern": "^rel_[1-9][0-9]*$"}},
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "relation_id", "source_claim_ref", "target_claim_ref", "relation_type", "rationale", "created_by_decision", "created_at"],
  "properties": {
    "schema_version": {"const": "ts-claim-relation/1"},
    "relation_id": {"$ref": "#/$defs/relation_id"},
    "source_claim_ref": {"$ref": "claim.schema.json#/$defs/claim_id"},
    "target_claim_ref": {"$ref": "claim.schema.json#/$defs/claim_id"},
    "relation_type": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$", "maxLength": 128},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 8000},
    "created_by_decision": {"$ref": "decision.schema.json#/$defs/decision_id"},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 64}
  }
}
