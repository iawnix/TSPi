{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation.schema.json",
  "$defs": {"observation_id": {"type": "string", "pattern": "^obs_[1-9][0-9]*$"}},
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "observation_id", "created_by_node", "concept_id", "subject_ref",
    "value", "datatype", "unit", "qualifiers", "summary", "artifact_refs", "provenance",
    "created_by_decision", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "ts-observation/2"},
    "observation_id": {"$ref": "#/$defs/observation_id"},
    "created_by_node": {"$ref": "research_node.schema.json#/$defs/node_id"},
    "concept_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$", "maxLength": 256},
    "subject_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "value": {},
    "datatype": {"enum": ["boolean", "integer", "number", "string", "string_array", "number_array", "object", "json"]},
    "unit": {"type": ["string", "null"], "maxLength": 128},
    "qualifiers": {"type": "object", "maxProperties": 32},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "artifact_refs": {"type": "array", "uniqueItems": true, "maxItems": 64, "items": {"type": "string", "pattern": "^art_[0-9a-f]{24}$"}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "producer_version", "source_digests"],
      "properties": {
        "producer": {"type": "string", "minLength": 1, "maxLength": 256},
        "producer_version": {"type": ["string", "null"], "maxLength": 128},
        "source_digests": {
          "type": "object",
          "propertyNames": {"pattern": "^art_[0-9a-f]{24}$"},
          "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "created_by_decision": {"$ref": "decision.schema.json#/$defs/decision_id"},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 64}
  }
}
