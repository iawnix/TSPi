{
  "name": "@iawnix/ts-agent",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "description": "Pi package for a domain-neutral ResearchMap scientific harness, deterministic validation, and bounded Compute and Review subagents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iawnix/TSPi.git"
  },
  "keywords": [
    "pi-package",
    "research-harness",
    "scientific-workflows",
    "research-map",
    "chemistry",
    "computational-chemistry",
    "research-dag",
    "agent-skill"
  ],
  "scripts": {
    "install-env": "python3 scripts/install_env.py --package-root . --workspace-root \"${TS_WORKSPACE_ROOT:?set TS_WORKSPACE_ROOT to the TS workspace root}\" --json",
    "install-env:core": "python3 scripts/install_env.py --package-root . --workspace-root \"${TS_WORKSPACE_ROOT:?set TS_WORKSPACE_ROOT to the TS workspace root}\" --json",
    "test:list": "python3 tools/test/runner.py list",
    "test:fast": "python3 tools/test/runner.py fast -- -q",
    "lint:public": "python3 tools/lint_public_surface.py",
    "test": "python3 tools/test/runner.py source -- -q",
    "test:subagents": "python3 tools/test/runner.py subagents",
    "test:package": "python3 tools/test/runner.py package",
    "test:native-pi": "python3 tools/test/runner.py native-pi",
    "test:remote-smoke": "python3 tools/test/runner.py remote-smoke --",
    "test:live-eval": "python3 tools/test/runner.py live-eval --",
    "release:agent": "python3 scripts/build_release.py --output-dir dist/agent --json",
    "release:build": "python3 scripts/build_package.py --output-dir dist/package --json",
    "typecheck": "tsc --noEmit"
  },
