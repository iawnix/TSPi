{
  "name": "@iawnix/coragent",
  "version": "0.19.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Pi package for research questions, immutable results and memory, generic Job Runtime, and artifact evidence.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iawnix/coragent.git"
  },
  "keywords": [
    "pi-package",
    "research-harness",
    "scientific-workflows",
    "chemistry",
    "computational-chemistry",
    "agent-skill",
    "research-memory"
  ],
  "scripts": {
    "install-env": "python3 scripts/install_env.py --package-root . --workspace-root \"${CORAGENT_WORKSPACE_ROOT:?set CORAGENT_WORKSPACE_ROOT to the CoRAgent workspace root}\" --json",
    "install-env:core": "python3 scripts/install_env.py --package-root . --workspace-root \"${CORAGENT_WORKSPACE_ROOT:?set CORAGENT_WORKSPACE_ROOT to the CoRAgent workspace root}\" --json",
    "test:list": "python3 tools/test/runner.py list",
    "test:fast": "python3 tools/test/runner.py fast -- -q",
    "lint:public": "python3 tools/lint_public_surface.py",
    "lint:architecture": "python3 tools/lint_architecture.py",
    "lint:skills": "python3 tools/lint_skills.py",
    "test": "python3 tools/test/runner.py source -- -q",
    "test:package": "python3 tools/test/runner.py package",
    "test:native-pi": "python3 tools/test/runner.py native-pi",
    "test:framework": "node --test tests/node/research-memory.test.mjs",
    "test:coragent": "python3 tools/test/runner.py native-pi",
    "test:remote-smoke": "python3 tools/test/runner.py remote-smoke --",
    "test:live-eval": "python3 tools/test/runner.py live-eval --",
    "release:agent": "python3 scripts/build_release.py --output-dir dist/agent --json",
    "release:build": "python3 scripts/build_package.py --output-dir dist/package --json",
    "typecheck": "python3 tools/generate_contracts.py --check && tsc --noEmit",
    "resources:check": "python3 scripts/update_resources.py --check",
    "resources:generate": "python3 scripts/update_resources.py",
    "version:check": "python3 tools/version.py check",
    "layout:check": "python3 tools/layout.py --check",
    "contracts:generate": "python3 tools/generate_contracts.py",
    "contracts:check": "python3 tools/generate_contracts.py --check"
  },
  "files": [
    "apps/agent",
    "apps/agent-cli",
    "backend/src/research_agent",
    "packages/link",
    "services/relay",
    "skills",
    "domains",
    "prompts",
    "contracts",
    "config",
    "assets",
    "scripts",
    "docs",
    "coragent",
    "install.sh",
    "libexec/coragent-host",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "backend/pyproject.toml",
    "environment.yml",
    "environment.lock.txt",
    "uninstall.sh",
    "python-dist/*.whl",
    "!config/models.json",
    "!config/auth.json",
    "!config/job.toml",
    "!config/name-resolver.toml",
    "!config/email.toml",
    "!config/smtp-password",
    "!config/secrets/**",
    "!scripts/_source_capture.py",
    "!scripts/build_release.py",
    "!scripts/build_package.py",
    "!scripts/build_web.py",
    "!scripts/check_package.py",
    "!scripts/update_*.py",
    "!scripts/update_*.mjs"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-durable": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "@earendil-works/pi-durable": "1.1.0"
  },
  "pi": {
    "skills": [
      "./skills",
      "./domains/chemical/skills"
    ],
    "themes": [
      "./apps/agent/terminal/themes/coragent.json"
    ],
    "extensions": []
  },
  "coragent": {
    "execution": [
      "domains/chemical/execution.json"
    ],
    "environments": [
      "domains/chemical/environments/manifest.json"
    ]
  }
}
