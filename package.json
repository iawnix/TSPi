{
  "name": "@iawnix/ts-agent",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "description": "Pi package for Phase-guided transition-state research with a ResearchNode DAG, deterministic validation, and bounded Compute and Review subagents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iawnix/TSPi.git"
  },
  "keywords": [
    "pi-package",
    "transition-state",
    "chemistry",
    "computational-chemistry",
    "research-dag",
    "agent-skill"
  ],
  "scripts": {
    "install-env": "python3 scripts/install_env.py --package-root . --workspace-root \"${TS_WORKSPACE_ROOT:?set TS_WORKSPACE_ROOT to the TS workspace root}\" --with-render --json",
    "install-env:core": "python3 scripts/install_env.py --package-root . --workspace-root \"${TS_WORKSPACE_ROOT:?set TS_WORKSPACE_ROOT to the TS workspace root}\" --json",
    "test:fast": "python3 scripts/test_fast.py -- -q",
    "lint:public": "python3 tools/lint_public_surface.py",
    "test": "python3 scripts/test_source.py -- -q",
    "test:pi-adapter": "python3 scripts/test_source.py -- -q tests/test_pi_agent_adapter.py tests/test_pi_subagent_contract.py tests/test_pi_subagent_ui.py tests/test_pi_compute_tools.py tests/test_pi_artifact_tools.py tests/test_pi_runtime_integration.py tests/test_agent_protocol.py",
    "test:subagents": "python3 scripts/test_source.py -- -q tests/test_pi_subagent_contract.py tests/test_pi_subagent_ui.py tests/test_pi_compute_tools.py tests/test_pi_artifact_tools.py tests/test_pi_runtime_integration.py tests/test_agent_protocol.py tests/test_agent_run_journal.py",
    "test:package": "python3 scripts/check_package.py",
    "test:terminal": "node tests/terminal.test.mjs",
    "test:terminal-host": "node tests/terminal-host.test.mjs",
    "release:agent": "python3 scripts/build_release.py --output-dir dist/agent --json",
    "release:build": "python3 scripts/build_package.py --phone-manifest \"${TS_PHONE_COMPONENT_MANIFEST:?set TS_PHONE_COMPONENT_MANIFEST to ts-phone-component-release.json}\" --output-dir dist/package --json",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "TSPi",
    "README.md",
    "README.zh-CN.md",
    "pyproject.toml",
    "docs/*.md",
    "docs/adr/*.md",
    "contracts/ts-phone/README.md",
    "contracts/ts-phone/bridge.schema.json",
    "contracts/ts-phone/events.schema.json",
    "contracts/ts-phone/manifest.json",
    "contracts/ts-phone/openapi.yaml",
    "contracts/ts-phone/versions.json",
    "contracts/ts-web/README.md",
    "contracts/ts-web/error.schema.json",
    "contracts/ts-web/workspace-request.schema.json",
    "contracts/ts-web/workspace-snapshot.fixture.json",
    "contracts/ts-web/workspace-snapshot.schema.json",
    "environment.yml",
    "extensions/shared/*.ts",
    "extensions/ts-phone-bridge/*.ts",
    "extensions/ts-phone-bridge/*.mjs",
    "extensions/ts-workflow-artifacts/*.ts",
    "extensions/ts-workflow-compute/*.ts",
    "extensions/ts-workflow-compute/*.cjs",
    "extensions/ts-workflow-control/*.ts",
    "extensions/ts-workflow-control/*.cjs",
    "extensions/ts-workflow-review/*.ts",
    "extensions/ts-workflow-ui/*.ts",
    "scripts/install_env.py",
    "scripts/install_package.py",
    "scripts/install_release.py",
    "scripts/_bootstrap.py",
    "scripts/_runtime_install.py",
    "scripts/_suite.py",
    "scripts/_wheel.py",
    "scripts/package_inventory.py",
    "scripts/tspi_host.py",
    "scripts/pi-loader.mjs",
    "scripts/ts_backend.py",
    "scripts/ts_compute.py",
    "scripts/ts_email.py",
    "scripts/ts_render.py",
    "scripts/ts_report.py",
    "scripts/ts_runtime.py",
    "scripts/ts_web.py",
    "scripts/ts_workspace.py",
    "skills/",
    "themes/*.json",
    "packages/ts-agent-runtime/agent-core/*.cjs",
    "packages/ts-agent-runtime/agents/compute/*.ts",
    "packages/ts-agent-runtime/agents/compute/*.cjs",
    "packages/ts-agent-runtime/agents/compute/prompts/*.md",
    "packages/ts-agent-runtime/agents/review/*.ts",
    "packages/ts-agent-runtime/agents/review/*.cjs",
    "packages/ts-agent-runtime/agents/review/roles/*.json",
    "packages/ts-agent-runtime/agents/review/prompts/*.md",
    "packages/ts-agent-runtime/artifacts/*.cjs",
    "apps/terminal/*.mjs",
    "apps/host/*.mjs",
    "packages/ts-agent-kernel/ts_agent/*.py",
    "packages/ts-agent-kernel/ts_agent/backends/*.py",
    "packages/ts-agent-kernel/ts_agent/compute/*.py",
    "packages/ts-agent-kernel/ts_agent/compute/contracts/*.json",
    "packages/ts-agent-kernel/ts_agent/email/*.py",
    "packages/ts-agent-kernel/ts_agent/remote/*.py",
    "packages/ts-agent-kernel/ts_agent/remote/*.toml",
    "packages/ts-agent-kernel/ts_agent/render/*.py",
    "packages/ts-agent-kernel/ts_agent/report/*.py",
    "packages/ts-agent-kernel/ts_agent/runtime/*.py",
    "packages/ts-agent-kernel/ts_agent/structures/*.py",
    "packages/ts-agent-kernel/ts_agent/validation/*.py",
    "packages/ts-agent-kernel/ts_agent/validation/predicates/*.py",
    "packages/ts-agent-kernel/ts_agent/validation/templates/builtin/*.json",
    "packages/ts-agent-kernel/ts_agent/validation/acceptance_profiles/*.json",
    "packages/ts-agent-kernel/ts_agent/web/*.py",
    "packages/ts-agent-kernel/ts_agent/projection/*.py",
    "packages/ts-agent-kernel/ts_agent/web/static/*.html",
    "packages/ts-agent-kernel/ts_agent/web/static/*.css",
    "packages/ts-agent-kernel/ts_agent/web/static/*.js",
    "packages/ts-agent-kernel/ts_agent/web/static/*.svg",
    "packages/ts-agent-kernel/ts_agent/workspace/*.py",
    "packages/ts-agent-kernel/ts_agent/workspace/contracts/*.json",
    "python-dist/*.whl"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.81.1 <1.0.0",
    "@earendil-works/pi-coding-agent": ">=0.81.1 <1.0.0",
    "@earendil-works/pi-tui": ">=0.81.1 <1.0.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  },
  "pi": {
    "skills": [
      "./skills/transition-state-workflow"
    ],
    "themes": [
      "./themes/ts-theme.json"
    ],
    "extensions": [
      "./extensions/ts-workflow-control",
      "./extensions/ts-workflow-ui/index.ts",
      "./extensions/ts-workflow-review/index.ts",
      "./extensions/ts-workflow-compute/index.ts",
      "./extensions/ts-workflow-artifacts/index.ts"
    ]
  }
}
