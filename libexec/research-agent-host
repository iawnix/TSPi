#!/usr/bin/env bash
set -euo pipefail
readonly ENTRY="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly PACKAGE_ROOT="$(dirname -- "$(dirname -- "$ENTRY")")"
exec python3 "$PACKAGE_ROOT/apps/agent-cli/tspi_launcher.py" --install-root "${TSPI_INSTALL_ROOT:?TSPI_INSTALL_ROOT is required}" -- --service-host "$@"
