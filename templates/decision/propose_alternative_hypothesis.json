{
  "schema_version": "ts-decision",
  "action": "propose_hypothesis",
  "rationale": "Propose a distinct mechanism hypothesis from evidence that changes a declared mechanism variable.",
  "evidence_refs": [
    "${EV_NEW_HYPOTHESIS_BASIS}"
  ],
  "report_ref": {
    "report_id": "${REPORT_ID}",
    "workspace_root": "${WORKSPACE_ROOT}"
  },
  "payload": {
    "proposed_hypothesis": {
      "hypothesis_id": "${NEW_HYPOTHESIS_ID}",
      "parent_hypothesis_id": "${HYPOTHESIS_ID}",
      "summary": "${NEW_HYPOTHESIS_SUMMARY}",
      "derived_from": {
        "reactant_ref": "${REACTANT_REF}",
        "product_ref": "${PRODUCT_REF}",
        "charge": "${CHARGE}",
        "multiplicity": "${MULTIPLICITY}",
        "atom_mapping_ref": "${ATOM_MAPPING_REF}"
      },
      "structured_claim": {
        "reaction_center": {
          "forming_bonds": [
            {
              "atoms": ["${FORMING_ATOM_A}", "${FORMING_ATOM_B}"],
              "label": "${FORMING_BOND_LABEL}"
            }
          ],
          "breaking_bonds": [],
          "transferred_atoms": [],
          "spectator_regions": []
        },
        "reaction_class": ["${NEW_REACTION_CLASS}"],
        "elementary_step_model": "${NEW_ELEMENTARY_STEP_MODEL}",
        "electronic_model": {
          "surface": "${NEW_ELECTRONIC_SURFACE}"
        }
      },
      "mechanism_claims": [],
      "testable_predictions": [
        {
          "prediction_id": "${NEW_PRED_CANDIDATE_ID}",
          "phase": "candidate_generation",
          "expectation": "${NEW_CANDIDATE_EXPECTATION}",
          "required_evidence_roles": ["candidate_geometry"]
        }
      ],
      "required_evidence": ["candidate_geometry"],
      "uncertainties": ["${NEW_HYPOTHESIS_UNCERTAINTY}"],
      "alternative_hypotheses": [],
      "evidence_refs": ["${EV_NEW_HYPOTHESIS_BASIS}"]
    },
    "proposal_context": {
      "kind": "alternative",
      "from_node": "${NEW_HYPOTHESIS_FROM_NODE}",
      "anchor_node": "${BRANCH_ANCHOR_NODE}",
      "changed_variable": "${NEW_HYPOTHESIS_CHANGED_VARIABLE}",
      "reason_code": "${NEW_HYPOTHESIS_REASON_CODE}",
      "evidence_refs": ["${EV_NEW_HYPOTHESIS_BASIS}"]
    }
  }
}
