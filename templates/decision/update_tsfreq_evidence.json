{
  "schema_version": "ts-decision",
  "action": "update_workspace",
  "rationale": "Register parsed TS/Freq evidence.",
  "evidence_refs": [],
  "report_ref": {
    "report_id": "${REPORT_ID}",
    "workspace_root": "${WORKSPACE_ROOT}"
  },
  "payload": {
    "append_evidence": {
      "evidence_id": "${EV_TSFREQ}",
      "kind": "gaussian_tsfreq_validation",
      "role": "tsfreq_gate",
      "evidence_tier": "local_parse",
      "node_id": "n002",
      "summary": "TS/Freq parsing found exactly one imaginary frequency and the mode matches the proposed reaction coordinate. The primary evidence path is a validation artifact owned by this TS/Freq node.",
      "path": "${TSFREQ_LOG_PATH}",
      "source_files": [
        "${TSFREQ_LOG_PATH}"
      ],
      "source_sha256": "${SOURCE_SHA256}",
      "parser_name": "${TSFREQ_PARSER_NAME}",
      "parser_version": "${PARSER_VERSION}",
      "normal_termination": true,
      "diagnostics": [],
      "quality": {
        "hypothesis_id": "${HYPOTHESIS_ID}",
        "prediction_ids": [
          "${PRED_MODE_ID}"
        ],
        "verdict_against_prediction": "supported",
        "imaginary_frequency_count": 1,
        "mode_verdict": "mode_matches_reaction_center"
      },
      "facts": {
        "method": "wB97x",
        "basis": "6-31G(d)",
        "source_log_ref": "Record the upstream Gaussian log in nodes/n002/outputs/artifact_manifest.json consumed_artifacts when the log was generated by an earlier candidate node.",
        "imaginary_frequencies_cm-1": [
          "${IMAGINARY_FREQUENCY_CM1}"
        ]
      }
    }
  }
}
