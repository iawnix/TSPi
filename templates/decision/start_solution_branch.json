{
  "schema_version": "ts-decision",
  "action": "start_node",
  "rationale": "Start a new solution branch under the same chemical hypothesis after agent review of the failed path.",
  "evidence_refs": [
    "${BACKTRACK_EVIDENCE_REF}"
  ],
  "report_ref": {
    "report_id": "${REPORT_ID}",
    "workspace_root": "${WORKSPACE_ROOT}"
  },
  "payload": {
    "node_id": "${NEW_BRANCH_NODE_ID}",
    "parent_node": "${BACKTRACK_TO_NODE}",
    "phase": "candidate_generation",
    "hypothesis": "Test a different candidate-generation strategy while keeping the same chemical hypothesis.",
    "hypothesis_ref": {
      "hypothesis_id": "${HYPOTHESIS_ID}",
      "prediction_ids": [
        "${PRED_CANDIDATE_ID}"
      ]
    },
    "solution_ref": {
      "solution_id": "${NEW_SOLUTION_ID}",
      "strategy": "${NEW_SOLUTION_STRATEGY}",
      "summary": "${NEW_SOLUTION_SUMMARY}",
      "parent_solution_id": "${PARENT_SOLUTION_ID}"
    },
    "pathway_ref": {
      "pathway_id": "${PATHWAY_ID}",
      "step_id": "${STEP_ID}"
    },
    "backtrack": {
      "from_node": "${BACKTRACK_FROM_NODE}",
      "to_node": "${BACKTRACK_TO_NODE}",
      "changed_variable": "solution_strategy",
      "reason_code": "${BACKTRACK_REASON_CODE}",
      "lineage_scope": "solution",
      "evidence_refs": [
        "${BACKTRACK_EVIDENCE_REF}"
      ]
    },
    "expected_evidence": [
      "candidate_geometry",
      "candidate_generation_log"
    ]
  }
}
