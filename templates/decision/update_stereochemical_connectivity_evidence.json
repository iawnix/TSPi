{
  "schema_version": "ts-decision",
  "action": "update_workspace",
  "rationale": "Register stereochemical endpoint/connectivity validation evidence for a stereo-sensitive hypothesis.",
  "evidence_refs": [],
  "report_ref": {
    "report_id": "${REPORT_ID}",
    "workspace_root": "${WORKSPACE_ROOT}"
  },
  "payload": {
    "append_evidence": {
      "evidence_id": "${EV_STEREOCHEMISTRY}",
      "kind": "stereochemical_connectivity_validation",
      "role": "stereochemical_connectivity_gate",
      "evidence_tier": "local_parse",
      "node_id": "n003",
      "summary": "Declared stereochemical checks match the assigned IRC endpoint basins. The primary evidence path is owned by this connectivity node.",
      "path": "${STEREOCHEMISTRY_SUMMARY_PATH}",
      "source_files": [
        "${STEREOCHEMISTRY_SUMMARY_PATH}"
      ],
      "source_sha256": "${SOURCE_SHA256}",
      "parser_name": "${STEREOCHEMISTRY_PARSER_NAME}",
      "parser_version": "${PARSER_VERSION}",
      "normal_termination": true,
      "diagnostics": [],
      "quality": {
        "hypothesis_id": "${HYPOTHESIS_ID}",
        "prediction_ids": [
          "${PRED_STEREO_ID}"
        ],
        "verdict_against_prediction": "supported",
        "stereochemical_verdict": "matched",
        "stereochemistry_matched": true,
        "stereochemical_mismatches": [],
        "stereochemical_checks": [
          {
            "type": "tetrahedral",
            "center": "${STEREO_CENTER_ATOM}",
            "policy": "retain",
            "verdict": "matched"
          }
        ]
      },
      "facts": {
        "source_connectivity_ref": "${IRC_SUMMARY_PATH}",
        "declared_policy": "Record the active hypothesis structured_claim.stereochemical_policy in this node-owned artifact."
      }
    }
  }
}
