{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS calculation intent v2",
  "type": "object",
  "required": ["schema_version", "intent_id", "node_id", "purpose", "validation_scope", "attempt_kind", "recalculation_ref", "backend", "task_type", "input_refs", "settings", "expected_artifacts", "execution_target", "dry_run"],
  "properties": {
    "schema_version": {"const": "ts-calculation-intent/2"},
    "intent_id": {"type": "string", "pattern": "^calc_[A-Za-z0-9_.-]+$", "maxLength": 128},
    "node_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "maxLength": 128},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 2000},
    "validation_scope": {"type": ["string", "null"], "enum": [null, "tsfreq", "connectivity", "electronic_structure", "state_character", "thermochemistry", "method_robustness", "geometry_identity"]},
    "attempt_kind": {"enum": ["primary", "retry", "recalculation"]},
    "recalculation_ref": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["source_node", "source_intent_id", "changed_settings", "purpose"],
          "properties": {
            "source_node": {"type": "string", "minLength": 1, "maxLength": 128},
            "source_intent_id": {"type": ["string", "null"], "maxLength": 128},
            "changed_settings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
            "purpose": {"enum": ["repair", "refinement", "method_robustness"]}
          },
          "additionalProperties": false
        }
      ]
    },
    "backend": {"enum": ["gaussian", "xtb", "ase_neb", "qbics_dmecp"]},
    "task_type": {"type": "string", "minLength": 1, "maxLength": 64},
    "input_refs": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$"}, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "settings": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 4096}},
    "expected_artifacts": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "execution_target": {
      "oneOf": [
        {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "local"}}, "additionalProperties": false},
        {
          "type": "object",
          "required": ["kind", "authority", "login_host", "compute_host", "remote_dir"],
          "properties": {
            "kind": {"const": "remote"},
            "authority": {"const": "execution_mirror"},
            "login_host": {"type": "string", "minLength": 1, "maxLength": 255},
            "compute_host": {"type": "string", "minLength": 1, "maxLength": 255},
            "remote_dir": {"type": "string", "minLength": 1, "maxLength": 4096}
          },
          "additionalProperties": false
        }
      ]
    },
    "dry_run": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"attempt_kind": {"const": "recalculation"}}},
      "then": {"properties": {"recalculation_ref": {"type": "object"}}},
      "else": {"properties": {"recalculation_ref": {"type": "null"}}}
    }
  ],
  "additionalProperties": false
}
