{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS calculation intent v2",
  "type": "object",
  "required": ["schema_version", "intent_id", "node_id", "purpose", "validation_scope", "attempt_kind", "recalculation_ref", "backend", "task_type", "input_refs", "input_bindings", "settings", "expected_artifacts", "execution_target", "dry_run"],
  "properties": {
    "schema_version": {"const": "ts-calculation-intent/2"},
    "intent_id": {"type": "string", "pattern": "^calc_[A-Za-z0-9_.-]+$", "maxLength": 128},
    "node_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "maxLength": 128},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 2000},
    "validation_scope": {"type": ["string", "null"], "enum": [null, "tsfreq", "connectivity", "electronic_structure", "state_character", "thermochemistry", "method_robustness", "geometry_identity"]},
    "attempt_kind": {"enum": ["primary", "retry", "recalculation"]},
    "recalculation_ref": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["source_node", "source_intent_id", "changed_settings", "purpose"],
          "properties": {
            "source_node": {"type": "string", "minLength": 1, "maxLength": 128},
            "source_intent_id": {"type": ["string", "null"], "maxLength": 128},
            "changed_settings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
            "purpose": {"enum": ["repair", "refinement", "method_robustness"]}
          },
          "additionalProperties": false
        }
      ]
    },
    "backend": {"enum": ["gaussian", "xtb", "crest", "ase_neb", "qbics_dmecp"]},
    "task_type": {"type": "string", "minLength": 1, "maxLength": 64},
    "input_refs": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$"}, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "input_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["input_role", "artifact_id", "path", "sha256", "owner_node", "source_intent_id"],
        "properties": {
          "input_role": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$", "maxLength": 64},
          "artifact_id": {"type": "string", "pattern": "^art_[0-9a-f]{24}$"},
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "owner_node": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "maxLength": 128},
          "source_intent_id": {"type": ["string", "null"], "pattern": "^calc_[A-Za-z0-9_.-]+$", "maxLength": 128}
        },
        "additionalProperties": false
      }
    },
    "settings": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 4096}},
    "expected_artifacts": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "execution_target": {
      "oneOf": [
        {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "local"}}, "additionalProperties": false},
        {
          "type": "object",
          "required": ["kind", "authority", "transport", "login_host", "compute_host", "remote_dir"],
          "properties": {
            "kind": {"const": "remote"},
            "authority": {"const": "execution_mirror"},
            "transport": {"const": "ssh"},
            "login_host": {"type": "string", "minLength": 1, "maxLength": 255},
            "compute_host": {"type": "string", "minLength": 1, "maxLength": 255},
            "remote_dir": {"type": "string", "minLength": 1, "maxLength": 4096}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "authority", "transport", "remote_dir", "execution"],
          "properties": {
            "kind": {"const": "remote"},
            "authority": {"const": "execution_mirror"},
            "transport": {"const": "mcp"},
            "remote_dir": {"type": "string", "minLength": 1, "maxLength": 4096},
            "execution": {"$ref": "#/$defs/mcp_execution"}
          },
          "additionalProperties": false
        }
      ]
    },
    "dry_run": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"attempt_kind": {"const": "recalculation"}}},
      "then": {"properties": {"recalculation_ref": {"type": "object"}}},
      "else": {"properties": {"recalculation_ref": {"type": "null"}}}
    }
  ],
  "$defs": {
    "mcp_execution": {
      "type": "object",
      "required": ["queue", "nodes", "ncpus", "memory", "walltime", "ngpus", "mpiprocs", "ompthreads", "host", "place", "environment", "gpu_devices"],
      "properties": {
        "queue": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
        "nodes": {"type": "integer", "minimum": 1},
        "ncpus": {"type": "integer", "minimum": 1},
        "memory": {"type": "string", "pattern": "^[1-9][0-9]*(?:kb|mb|gb|tb)$"},
        "walltime": {"type": "string", "pattern": "^[0-9]{1,4}:[0-5][0-9]:[0-5][0-9]$"},
        "ngpus": {"type": "integer", "minimum": 0},
        "mpiprocs": {"type": ["integer", "null"], "minimum": 1},
        "ompthreads": {"type": ["integer", "null"], "minimum": 1},
        "host": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "place": {"type": ["string", "null"], "enum": [null, "free", "pack", "scatter", "excl", "shared"]},
        "environment": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "additionalProperties": {"type": "string", "maxLength": 16384}
        },
        "gpu_devices": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 63}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
