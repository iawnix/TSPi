{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS calculation result",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "intent_id",
    "node_id",
    "state",
    "program_status",
    "exit_status",
    "artifact_refs",
    "parser_facts",
    "error_class",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "ts-calculation-result/1"},
    "job_id": {"type": ["string", "null"]},
    "intent_id": {"type": "string", "pattern": "^calc_[A-Za-z0-9_.-]+$"},
    "node_id": {"type": "string", "minLength": 1},
    "state": {
      "enum": ["prepared", "submitted", "queued", "running", "completed", "failed", "stopped", "collected", "parsed", "missing", "unknown"]
    },
    "program_status": {"enum": ["completed", "failed", "stopped", "not_run"]},
    "exit_status": {"type": ["integer", "null"]},
    "artifact_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "parser_facts": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": ["claim_verdict", "accepted_ts", "accepted_ts_ref", "pathway_accepted", "strict_pathway_decision"]
        }
      }
    },
    "error_class": {"type": ["string", "null"]},
    "control": {
      "type": "object",
      "required": [
        "schema_version",
        "operation",
        "phase",
        "effect_outcome",
        "effect_attempted",
        "retry_disposition",
        "reconciliation_required",
        "submission_id",
        "job_id"
      ],
      "properties": {
        "schema_version": {"const": "ts-control-outcome/1"},
        "operation": {"enum": ["submit", "cancel"]},
        "phase": {
          "enum": [
            "prepare_staging",
            "ensure_directory",
            "upload",
            "submit_request",
            "scheduler_accept",
            "receipt_persist",
            "reconciled",
            "cancel_request",
            "cancel_confirmed"
          ]
        },
        "effect_outcome": {"enum": ["succeeded", "failed", "unknown"]},
        "effect_attempted": {"type": "boolean"},
        "retry_disposition": {
          "enum": ["none", "retry_same_submission", "new_intent", "reconcile_only"]
        },
        "reconciliation_required": {"type": "boolean"},
        "submission_id": {"type": ["string", "null"]},
        "job_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "provenance": {"type": "object"}
  },
  "additionalProperties": false
}
