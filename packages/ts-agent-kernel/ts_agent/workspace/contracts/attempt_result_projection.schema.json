{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workspace calculation Attempt result projection",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "intent_id",
    "node_id",
    "capability",
    "capability_version",
    "expected_output_roles",
    "state",
    "program_status",
    "exit_status",
    "artifact_refs",
    "parser_facts",
    "error_class",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "ts-calculation-result/2"},
    "job_id": {"type": ["string", "null"]},
    "intent_id": {"type": "string", "pattern": "^calc_[1-9][0-9]*$"},
    "node_id": {"type": "string", "pattern": "^node_[1-9][0-9]*$"},
    "capability": {"type": "string", "minLength": 1},
    "capability_version": {"type": "string", "minLength": 1},
    "expected_output_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "state": {
      "enum": [
        "prepared",
        "submitted",
        "queued",
        "running",
        "completed",
        "failed",
        "stopped",
        "collected",
        "parsed",
        "missing",
        "unknown"
      ]
    },
    "program_status": {"enum": ["completed", "failed", "stopped", "not_run"]},
    "exit_status": {"type": ["integer", "null"]},
    "artifact_refs": {"type": "array", "items": {"type": "string"}},
    "parser_facts": {"type": "object"},
    "error_class": {"type": ["string", "null"]},
    "provenance": {
      "type": "object",
      "required": [
        "intent_digest",
        "capability",
        "capability_version",
        "capability_descriptor_digest"
      ]
    }
  },
  "additionalProperties": true
}
