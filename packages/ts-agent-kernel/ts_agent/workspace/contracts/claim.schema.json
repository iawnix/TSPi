{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "$defs": {
    "claim_id": {"type": "string", "pattern": "^claim_[1-9][0-9]*$"},
    "status": {"enum": ["proposed", "supported", "contradicted", "inconclusive", "withdrawn"]}
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "claim_id", "question", "claim_type", "statement", "scope",
    "uncertainty", "status", "assumptions", "predictions", "falsifiers", "tags",
    "preregistration_digest", "preregistered_at", "created_by_node", "observation_refs",
    "proof_spec_refs", "validation_result_refs", "history", "created_by_decision", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "ts-claim/4"},
    "claim_id": {"$ref": "#/$defs/claim_id"},
    "question": {"type": "string", "minLength": 1, "maxLength": 4000},
    "claim_type": {"type": "string", "minLength": 1, "maxLength": 128},
    "statement": {"type": "string", "minLength": 1, "maxLength": 12000},
    "scope": {"type": "string", "minLength": 1, "maxLength": 4000},
    "uncertainty": {"type": "string", "minLength": 1, "maxLength": 4000},
    "status": {"$ref": "#/$defs/status"},
    "assumptions": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "predictions": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "falsifiers": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "tags": {"type": "array", "uniqueItems": true, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "preregistration_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "preregistered_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "created_by_node": {"oneOf": [{"$ref": "research_node.schema.json#/$defs/node_id"}, {"type": "null"}]},
    "observation_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "observation.schema.json#/$defs/observation_id"}},
    "proof_spec_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "proof_spec.schema.json#/$defs/proof_id"}},
    "validation_result_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "validation_result.schema.json#/$defs/result_id"}},
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "summary", "observation_refs", "validation_result_refs", "decision_id", "created_at"],
        "properties": {
          "status": {"$ref": "#/$defs/status"},
          "summary": {"type": "string", "minLength": 1, "maxLength": 8000},
          "observation_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "observation.schema.json#/$defs/observation_id"}},
          "validation_result_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "validation_result.schema.json#/$defs/result_id"}},
          "decision_id": {"$ref": "decision.schema.json#/$defs/decision_id"},
          "created_at": {"type": "string", "minLength": 1, "maxLength": 64}
        }
      }
    },
    "created_by_decision": {"$ref": "decision.schema.json#/$defs/decision_id"},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 64}
  }
}
