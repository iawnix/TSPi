{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding_candidates.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "intent_id", "node_id", "capability", "capability_version",
    "parser", "source_artifacts", "candidates", "diagnostics"
  ],
  "properties": {
    "schema_version": {"const": "ts-finding-candidates/1"},
    "intent_id": {"type": "string", "pattern": "^calc_[1-9][0-9]*$"},
    "node_id": {"type": "string", "pattern": "^node_[1-9][0-9]*$"},
    "capability": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
    "capability_version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "parser": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "contract"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "contract": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "source_artifacts": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "path", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^art_[0-9a-f]{24}$"},
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "candidates": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "candidate_id", "concept_id", "subject_ref", "value", "datatype", "unit",
          "qualifiers", "summary", "source_artifact_ids"
        ],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^candidate_[1-9][0-9]*$"},
          "concept_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$", "maxLength": 256},
          "subject_ref": {"type": "string", "minLength": 1, "maxLength": 512},
          "value": {},
          "datatype": {"enum": ["boolean", "integer", "number", "string", "string_array", "number_array", "object", "json"]},
          "unit": {"type": ["string", "null"], "maxLength": 128},
          "qualifiers": {
            "type": "object", "maxProperties": 32,
            "required": ["capability", "capability_version", "parser_field"],
            "properties": {
              "capability": {"type": "string", "minLength": 1, "maxLength": 128},
              "capability_version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
              "parser_field": {"type": "string", "minLength": 1, "maxLength": 256}
            },
            "additionalProperties": true
          },
          "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
          "source_artifact_ids": {
            "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^art_[0-9a-f]{24}$"}
          }
        }
      }
    },
    "diagnostics": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 1000}}
  }
}
