{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate_spec.schema.json",
  "$defs": {
    "gate_id": {"type": "string", "pattern": "^gate_[1-9][0-9]*$"},
    "check_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$", "maxLength": 128},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "predicate", "predicate_version", "parameters", "blocking"],
      "properties": {
        "check_id": {"$ref": "#/$defs/check_id"},
        "predicate": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$", "maxLength": 128},
        "predicate_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "parameters": {"type": "object", "maxProperties": 64},
        "blocking": {"type": "boolean"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "gate_id", "scope", "target_node_ref", "target_claim_ref",
    "title", "purpose", "profile_ref", "checks", "success_policy",
    "created_by_node", "created_by_decision", "created_at", "frozen_at", "gate_digest"
  ],
  "properties": {
    "schema_version": {"const": "ts-gate-spec/1"},
    "gate_id": {"$ref": "#/$defs/gate_id"},
    "scope": {"enum": ["node", "claim"]},
    "target_node_ref": {
      "oneOf": [
        {"$ref": "research_node.schema.json#/$defs/node_id"},
        {"type": "null"}
      ]
    },
    "target_claim_ref": {
      "oneOf": [
        {"$ref": "claim.schema.json#/$defs/claim_id"},
        {"type": "null"}
      ]
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 4000},
    "profile_ref": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile_id", "version"],
          "properties": {
            "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "maxLength": 128},
            "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "maxLength": 64}
          }
        }
      ]
    },
    "checks": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/check"}},
    "success_policy": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["all", "all_blocking"]}}},
    "created_by_node": {"oneOf": [{"$ref": "research_node.schema.json#/$defs/node_id"}, {"type": "null"}]},
    "created_by_decision": {"$ref": "decision.schema.json#/$defs/decision_id"},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "frozen_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "gate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "scope": {"const": "node"},
            "target_node_ref": {"$ref": "research_node.schema.json#/$defs/node_id"},
            "target_claim_ref": {"type": "null"}
          }
        },
        {
          "properties": {
            "scope": {"const": "claim"},
            "target_node_ref": {"type": "null"},
            "target_claim_ref": {"$ref": "claim.schema.json#/$defs/claim_id"}
          }
        }
      ]
    }
  ]
}
