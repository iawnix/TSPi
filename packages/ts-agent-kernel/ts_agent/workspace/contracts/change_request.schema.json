{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "change_request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rationale", "basis_refs", "operations"],
  "properties": {
    "schema_version": {"const": "ts-change-request/1"},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 12000},
    "basis_refs": {"type": "array", "uniqueItems": true, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "expected_revision": {"type": "integer", "minimum": 0},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "maxProperties": 24,
        "propertyNames": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "maxLength": 64
        },
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
