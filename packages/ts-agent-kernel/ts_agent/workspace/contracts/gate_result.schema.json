{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate_result.schema.json",
  "$defs": {
    "gate_result_id": {"type": "string", "pattern": "^gate_result_[1-9][0-9]*$"},
    "verdict": {"enum": ["pass", "fail", "inconclusive", "blocked"]},
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "predicate", "predicate_version", "blocking", "verdict", "observation_refs", "validation_result_refs", "finding_refs", "artifact_refs", "message"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$", "maxLength": 128},
        "predicate": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$", "maxLength": 128},
        "predicate_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "blocking": {"type": "boolean"},
        "verdict": {"$ref": "#/$defs/verdict"},
        "observation_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "observation.schema.json#/$defs/observation_id"}},
        "validation_result_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "validation_result.schema.json#/$defs/result_id"}},
        "finding_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "finding.schema.json#/$defs/finding_id"}},
        "artifact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^art_[0-9a-f]{24}$"}},
        "message": {"type": "string", "maxLength": 2000}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "gate_result_id", "gate_ref", "gate_digest", "scope",
    "target_node_ref", "target_claim_ref", "verdict", "observation_refs", "validation_result_refs", "finding_refs",
    "artifact_refs", "check_results", "input_revision", "evaluated_by_node",
    "evaluated_by_decision", "evaluated_at", "result_digest"
  ],
  "properties": {
    "schema_version": {"const": "ts-gate-result/1"},
    "gate_result_id": {"$ref": "#/$defs/gate_result_id"},
    "gate_ref": {"$ref": "gate_spec.schema.json#/$defs/gate_id"},
    "gate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scope": {"enum": ["node", "claim"]},
    "target_node_ref": {
      "oneOf": [
        {"$ref": "research_node.schema.json#/$defs/node_id"},
        {"type": "null"}
      ]
    },
    "target_claim_ref": {
      "oneOf": [
        {"$ref": "claim.schema.json#/$defs/claim_id"},
        {"type": "null"}
      ]
    },
    "verdict": {"$ref": "#/$defs/verdict"},
    "observation_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "observation.schema.json#/$defs/observation_id"}},
    "validation_result_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "validation_result.schema.json#/$defs/result_id"}},
    "finding_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "finding.schema.json#/$defs/finding_id"}},
    "artifact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^art_[0-9a-f]{24}$"}},
    "check_results": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/check_result"}},
    "input_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluated_by_node": {"oneOf": [{"$ref": "research_node.schema.json#/$defs/node_id"}, {"type": "null"}]},
    "evaluated_by_decision": {"$ref": "decision.schema.json#/$defs/decision_id"},
    "evaluated_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "result_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "scope": {"const": "node"},
            "target_node_ref": {"$ref": "research_node.schema.json#/$defs/node_id"},
            "target_claim_ref": {"type": "null"}
          }
        },
        {
          "properties": {
            "scope": {"const": "claim"},
            "target_node_ref": {"type": "null"},
            "target_claim_ref": {"$ref": "claim.schema.json#/$defs/claim_id"}
          }
        }
      ]
    }
  ]
}
