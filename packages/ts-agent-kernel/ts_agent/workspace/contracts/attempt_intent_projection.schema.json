{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workspace calculation Attempt intent projection",
  "type": "object",
  "required": [
    "schema_version",
    "intent_id",
    "node_id",
    "node_contract_digest",
    "scientific_intent_digest",
    "capability",
    "capability_version",
    "capability_descriptor_digest",
    "expected_output_roles",
    "backend",
    "task_type",
    "input_bindings",
    "parameters",
    "execution_target",
    "dry_run"
  ],
  "properties": {
    "schema_version": {"const": "ts-calculation-intent/7"},
    "intent_id": {"type": "string", "pattern": "^calc_[1-9][0-9]*$"},
    "node_id": {"type": "string", "pattern": "^node_[1-9][0-9]*$"},
    "node_contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scientific_intent_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "capability": {"type": "string", "minLength": 1},
    "capability_version": {"type": "string", "minLength": 1},
    "capability_descriptor_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "expected_output_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "backend": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "minLength": 1},
    "input_bindings": {"type": "array", "minItems": 1},
    "parameters": {"type": "object"},
    "execution_target": {"type": "object"},
    "dry_run": {"type": "boolean"}
  },
  "additionalProperties": true
}
