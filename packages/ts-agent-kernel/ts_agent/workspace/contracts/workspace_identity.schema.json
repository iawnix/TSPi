{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS workspace identity",
  "type": "object",
  "required": ["schema_version", "workspace_id", "created_at"],
  "properties": {
    "schema_version": {"const": "ts-workspace-identity/1"},
    "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
