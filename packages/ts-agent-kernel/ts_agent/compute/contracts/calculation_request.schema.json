{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS capability calculation request",
  "type": "object",
  "required": [
    "schema_version", "node_id", "purpose", "attempt_kind", "lineage",
    "capability", "capability_version", "input_artifacts", "parameters",
    "execution_target", "dry_run"
  ],
  "properties": {
    "schema_version": {"const": "ts-calculation-request/5"},
    "node_id": {"type": "string", "pattern": "^node_[1-9][0-9]*$"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 2000},
    "attempt_kind": {"enum": ["primary", "retry", "recalculation"]},
    "lineage": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["source_node", "source_intent_id", "relation", "reason"],
          "properties": {
            "source_node": {"type": "string", "pattern": "^node_[1-9][0-9]*$"},
            "source_intent_id": {"type": "string", "pattern": "^calc_[1-9][0-9]*$", "maxLength": 128},
            "relation": {"enum": ["retry", "recalculation"]},
            "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
          },
          "additionalProperties": false
        }
      ]
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:[.][a-z][a-z0-9_]*)+$",
      "maxLength": 128
    },
    "capability_version": {"type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 16},
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["input_role", "artifact_id"],
        "properties": {
          "input_role": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$", "maxLength": 64},
          "artifact_id": {"type": "string", "pattern": "^art_[0-9a-f]{24}$"}
        },
        "additionalProperties": false
      }
    },
    "parameters": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "maxLength": 4096},
          {"type": "number"},
          {"type": "boolean"}
        ]
      }
    },
    "execution_target": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": {"kind": {"const": "local"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "profile", "resources"],
          "properties": {
            "kind": {"const": "remote"},
            "profile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
            "resources": {"$ref": "calculation_intent.schema.json#/$defs/remote_resources"}
          },
          "additionalProperties": false
        }
      ]
    },
    "dry_run": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"attempt_kind": {"const": "primary"}}},
      "then": {"properties": {"lineage": {"type": "null"}}},
      "else": {"properties": {"lineage": {"type": "object"}}}
    },
    {
      "if": {"properties": {"attempt_kind": {"const": "retry"}}},
      "then": {"properties": {"lineage": {"properties": {"relation": {"const": "retry"}}}}}
    },
    {
      "if": {"properties": {"attempt_kind": {"const": "recalculation"}}},
      "then": {"properties": {"lineage": {"properties": {"relation": {"const": "recalculation"}}}}}
    }
  ],
  "additionalProperties": false
}
