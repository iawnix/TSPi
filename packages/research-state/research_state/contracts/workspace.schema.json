{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "kernel_protocol", "created_at"],
  "properties": {
    "schema_version": {"const": "research-workspace/1"},
    "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "kernel_protocol": {"const": "research-map/1"},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 64}
  }
}
