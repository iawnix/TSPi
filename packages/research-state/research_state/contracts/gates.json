{
  "schema_version": "research-gate-contract/1",
  "criterion": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "source_type": {
        "enum": [
          "agent_assessment",
          "runtime_fact",
          "validator_result"
        ]
      },
      "description": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "fact": {
        "enum": [
          "execution_succeeded",
          "outputs_collected",
          "artifacts_registered"
        ]
      },
      "validator_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "validator_version": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "bindings": {
        "type": "object",
        "maxProperties": 32,
        "additionalProperties": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      }
    },
    "required": [
      "id",
      "source_type"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "source_type": {
              "const": "runtime_fact"
            }
          }
        },
        "then": {
          "required": [
            "fact"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "source_type": {
              "const": "validator_result"
            }
          }
        },
        "then": {
          "required": [
            "validator_id",
            "validator_version"
          ]
        }
      },
      {
        "if": {
          "required": [
            "bindings"
          ]
        },
        "then": {
          "properties": {
            "source_type": {
              "const": "validator_result"
            }
          }
        }
      }
    ]
  },
  "assessment": {
    "type": "object",
    "properties": {
      "criterion_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "verdict": {
        "enum": [
          "pass",
          "fail",
          "inconclusive",
          "blocked"
        ]
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "result_receipt_ref": {
        "type": "string",
        "pattern": "^result_[0-9a-f]{64}$"
      }
    },
    "required": [
      "criterion_id"
    ],
    "additionalProperties": false,
    "anyOf": [
      {
        "required": [
          "verdict",
          "reason"
        ]
      },
      {
        "required": [
          "result_receipt_ref"
        ]
      }
    ]
  },
  "evidence_relations": [
    "supports",
    "contradicts",
    "qualifies",
    "derived_from",
    "documents"
  ],
  "examples": {
    "create_gate": {
      "type": "create_gate",
      "id": "gate_delivery",
      "scope": "node",
      "target_id": "node_delivery",
      "criteria": [
        {
          "id": "delivery_receipt",
          "source_type": "agent_assessment",
          "description": "Inspect the registered delivery receipt"
        }
      ]
    },
    "evaluate_gate": {
      "type": "evaluate_gate",
      "gate_id": "gate_delivery",
      "verdict": "pass",
      "assessments": [
        {
          "criterion_id": "delivery_receipt",
          "verdict": "pass",
          "reason": "Inspected the registered receipt; transport accepted the report."
        }
      ],
      "evidence_refs": [
        "art_receipt"
      ]
    }
  }
}
