{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability_descriptor",
  "title": "Capability descriptor",
  "type": "object",
  "required": ["protocol", "version", "capability_id", "capability_version", "kind", "summary", "input_schema", "output_schema", "provider"],
  "properties": {
    "protocol": {"const": "capability_descriptor"},
    "version": {"const": 1},
    "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "capability_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"},
    "kind": {"enum": ["compute", "analysis", "artifact", "notification"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "input_schema": {"type": "object"},
    "output_schema": {"type": "object"},
    "provider": {
      "type": "object",
      "required": ["provider_id", "provider_version", "descriptor_digest"],
      "properties": {
        "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
        "provider_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"},
        "descriptor_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "limits": {"type": "object", "maxProperties": 64},
    "effects": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}}
  },
  "additionalProperties": false
}
