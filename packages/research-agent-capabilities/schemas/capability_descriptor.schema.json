{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-agent-capability-descriptor-1",
  "title": "Research agent capability descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "version",
    "provider_id",
    "input_kinds",
    "output_kinds",
    "parameter_schema",
    "environment_requirements",
    "supported_workspace_modes",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": "research-agent-capability/1"},
    "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "input_kinds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "output_kinds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "parameter_schema": {"type": "object", "properties": {"type": {"const": "object"}}, "required": ["type"]},
    "environment_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "supported_workspace_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["light", "research"]}
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}
  }
}
