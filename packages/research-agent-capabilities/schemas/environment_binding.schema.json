{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-agent-environment-binding-1",
  "title": "Research agent environment binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "provider_id",
    "environment_id",
    "environment_kind",
    "binding_digest",
    "readiness"
  ],
  "properties": {
    "schema_version": {"const": "research-agent-environment-binding/1"},
    "capability_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "environment_id": {"type": "string", "minLength": 1},
    "environment_kind": {"type": "string", "minLength": 1},
    "execution_kind": {"enum": ["local", "remote"]},
    "binding_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "checks"],
      "properties": {
        "state": {"enum": ["configured", "ready", "not_ready", "unknown", "error"]},
        "checks": {"type": "array", "items": {"type": "object"}},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
