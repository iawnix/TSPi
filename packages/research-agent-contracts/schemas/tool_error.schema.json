{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool_error",
  "title": "Tool error",
  "type": "object",
  "required": ["protocol", "version", "tool_name", "tool_call_id", "error_code", "message", "retryable", "failure_class"],
  "properties": {
    "protocol": {"const": "tool_error"},
    "version": {"const": 1},
    "tool_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$"},
    "tool_call_id": {"type": "string", "pattern": "^call_[A-Za-z0-9_-]{1,127}$"},
    "error_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$"},
    "message": {"type": "string", "minLength": 1, "maxLength": 4096},
    "retryable": {"type": "boolean"},
    "failure_class": {"enum": ["validation", "authorization", "workspace", "conflict", "ambiguous", "transient", "execution", "contract"]},
    "details": {"type": "object", "maxProperties": 64}
  },
  "additionalProperties": false
}
