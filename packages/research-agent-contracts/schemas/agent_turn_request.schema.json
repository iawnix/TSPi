{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_turn_request",
  "title": "Lightweight agent turn request",
  "type": "object",
  "required": ["protocol", "version", "request_id", "workspace_id", "session_id", "input"],
  "properties": {
    "protocol": {"const": "agent_turn_request"},
    "version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "input": {"type": "string", "minLength": 1, "maxLength": 100000},
    "context": {"type": "object", "maxProperties": 64}
  },
  "additionalProperties": false
}
