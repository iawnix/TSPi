{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_turn_request",
  "title": "Research turn request",
  "type": "object",
  "required": ["protocol", "version", "request_id", "workspace_id", "operation", "input"],
  "properties": {
    "protocol": {"const": "research_turn_request"},
    "version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "input": {"type": "object", "maxProperties": 256},
    "context": {"type": "object", "maxProperties": 64}
  },
  "additionalProperties": false
}
