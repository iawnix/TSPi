{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool_result",
  "title": "Tool result",
  "type": "object",
  "required": ["protocol", "version", "tool_name", "tool_call_id", "status", "output"],
  "properties": {
    "protocol": {"const": "tool_result"},
    "version": {"const": 1},
    "tool_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$"},
    "tool_call_id": {"type": "string", "pattern": "^call_[A-Za-z0-9_-]{1,127}$"},
    "status": {"const": "ok"},
    "output": {},
    "artifacts": {
      "type": "array",
      "maxItems": 256,
      "items": {"type": "string", "pattern": "^art_[A-Za-z0-9_-]{1,127}$"}
    }
  },
  "additionalProperties": false
}
