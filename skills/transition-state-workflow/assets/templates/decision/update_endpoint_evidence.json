{
  "schema_version": "ts-decision",
  "action": "update_workspace",
  "rationale": "Register endpoint provenance, charge/multiplicity, atom mapping, and reaction-center deltas.",
  "evidence_refs": [],
  "report_ref": {
    "report_id": "${REPORT_ID}",
    "workspace_root": "${WORKSPACE_ROOT}"
  },
  "payload": {
    "append_evidence": [
      {
        "evidence_id": "${EV_ENDPOINT_PROVENANCE}",
        "kind": "endpoint_input",
        "role": "endpoint_provenance",
        "evidence_tier": "user_provided",
        "node_id": "n000",
        "summary": "Reactant and product XYZ files were staged from the user-provided endpoint directory.",
        "path": "${ENDPOINT_PROVENANCE_PATH}",
        "facts": {
          "reactant_ref": "${REACTANT_REF}",
          "product_ref": "${PRODUCT_REF}"
        }
      },
      {
        "evidence_id": "${EV_CHARGE_MULTIPLICITY}",
        "kind": "system_metadata",
        "role": "charge_multiplicity",
        "evidence_tier": "user_provided",
        "node_id": "n000",
        "summary": "Charge and multiplicity were provided by the user.",
        "facts": {
          "charge": "${CHARGE}",
          "multiplicity": "${MULTIPLICITY}"
        }
      },
      {
        "evidence_id": "${EV_ATOM_MAPPING}",
        "kind": "atom_mapping",
        "role": "atom_mapping",
        "evidence_tier": "manual_observation",
        "node_id": "n000",
        "summary": "Reactant and product atom order or atom mapping was checked before mechanism hypothesis generation.",
        "path": "${ATOM_MAPPING_REF}"
      },
      {
        "evidence_id": "${EV_REACTION_CENTER_DELTA}",
        "kind": "endpoint_delta",
        "role": "reaction_center_delta",
        "evidence_tier": "manual_observation",
        "node_id": "n000",
        "summary": "Endpoint comparison identifies reaction-center bond changes for later hypothesis proposal.",
        "facts": {
          "forming_bonds": [
            "${FORMING_BOND_LABEL}"
          ],
          "breaking_bonds": []
        }
      }
    ]
  }
}
