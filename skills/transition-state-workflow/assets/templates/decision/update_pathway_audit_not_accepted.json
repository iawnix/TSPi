{
  "schema_version": "ts-decision",
  "action": "update_workspace",
  "rationale": "Register negative pathway-audit evidence for the current mechanism branch.",
  "evidence_refs": [],
  "report_ref": {
    "report_id": "${REPORT_ID}",
    "workspace_root": "${WORKSPACE_ROOT}"
  },
  "payload": {
    "append_evidence": {
      "evidence_id": "${EV_PATHWAY_AUDIT}",
      "kind": "pathway_audit",
      "role": "pathway_audit_summary",
      "evidence_tier": "local_parse",
      "node_id": "n005",
      "summary": "The current branch does not strictly support the requested R to P pathway.",
      "path": "${PATHWAY_AUDIT_PATH}",
      "source_files": [
        "${PATHWAY_AUDIT_PATH}"
      ],
      "source_sha256": "${SOURCE_SHA256}",
      "parser_name": "${PATHWAY_AUDIT_PARSER_NAME}",
      "parser_version": "${PARSER_VERSION}",
      "normal_termination": true,
      "quality": {
        "hypothesis_id": "${HYPOTHESIS_ID}",
        "prediction_ids": [
          "${PRED_PATHWAY_ID}"
        ],
        "strict_pathway_supported": false,
        "strict_pathway_decision": "pathway_not_accepted"
      },
      "facts": {
        "whole_R_to_P_pathway_accepted": false,
        "audit_outcome": "pathway_not_accepted"
      },
      "diagnostics": [
        "${PATHWAY_AUDIT_DIAGNOSTIC}"
      ]
    }
  }
}
