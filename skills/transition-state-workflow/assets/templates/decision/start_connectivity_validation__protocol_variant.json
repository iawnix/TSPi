{
  "schema_version": "ts-decision",
  "action": "start_node",
  "rationale": "Re-run IRC on the same TS/Freq-supported checkpoint with a different integrator / corrector / step size after a program-level failure on the previous attempt. The scientific claim is unchanged; this is a continuation of the same connectivity validation, not a new candidate.",
  "evidence_refs": [
    "${EV_TSFREQ}",
    "${EV_PREVIOUS_ATTEMPT_SUMMARY}"
  ],
  "report_ref": {
    "report_id": "${REPORT_ID}",
    "workspace_root": "${WORKSPACE_ROOT}"
  },
  "payload": {
    "node_id": "${NEW_NODE_ID}",
    "parent_node": "${TSFREQ_SUPPORTED_NODE_ID}",
    "phase": "connectivity_validation",
    "hypothesis": "Same TS claim; IRC protocol variant after program failure on the previous connectivity attempt.",
    "hypothesis_ref": {
      "hypothesis_id": "${HYPOTHESIS_ID}",
      "prediction_ids": [
        "${PRED_CONN_ID}"
      ]
    },
    "branch_context": {
      "relation": "continue_parent",
      "from_node": "${TSFREQ_SUPPORTED_NODE_ID}",
      "anchor_node": "${HYPOTHESIS_SOURCE_NODE}",
      "changed_variable": "${IRC_PROTOCOL_VARIABLE}",
      "reason_code": "${PREVIOUS_ATTEMPT_FAILURE_CODE}",
      "evidence_refs": [
        "${EV_PREVIOUS_ATTEMPT_SUMMARY}"
      ]
    },
    "pathway_ref": {
      "pathway_id": "${PATHWAY_ID}",
      "step_id": "${STEP_ID}"
    },
    "expected_evidence": [
      "irc_output",
      "connectivity_gate",
      "irc_endpoint_assignment"
    ]
  }
}
