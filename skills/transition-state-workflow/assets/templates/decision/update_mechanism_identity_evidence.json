{
  "schema_version": "ts-decision",
  "action": "update_workspace",
  "rationale": "Register mechanism-claim reflection evidence for a declared geometry/electronic/state identity gate.",
  "evidence_refs": [],
  "report_ref": {
    "report_id": "${REPORT_ID}",
    "workspace_root": "${WORKSPACE_ROOT}"
  },
  "payload": {
    "append_evidence": {
      "evidence_id": "${EV_MECHANISM_REFLECTION}",
      "kind": "${MECHANISM_REFLECTION_KIND}",
      "role": "${MECHANISM_REFLECTION_GATE_ROLE}",
      "evidence_tier": "local_parse",
      "node_id": "${NODE_ID}",
      "summary": "${MECHANISM_REFLECTION_SUMMARY}",
      "path": "${MECHANISM_REFLECTION_PATH}",
      "source_files": [
        "${MECHANISM_REFLECTION_PATH}"
      ],
      "source_sha256": "${SOURCE_SHA256}",
      "parser_name": "${MECHANISM_REFLECTION_PARSER_NAME}",
      "parser_version": "${PARSER_VERSION}",
      "normal_termination": true,
      "diagnostics": [],
      "quality": {
        "hypothesis_id": "${HYPOTHESIS_ID}",
        "prediction_ids": [
          "${PRED_MECHANISM_REFLECTION_ID}"
        ],
        "${MECHANISM_REFLECTION_COMPLETED_KEY}": true,
        "verdict_against_declared_claim": "${MECHANISM_REFLECTION_VERDICT}"
      },
      "facts": {
        "claim_id": "${MECHANISM_CLAIM_ID}",
        "identity_or_state_label": "${IDENTITY_OR_STATE_LABEL}",
        "claim_boundary": "${MECHANISM_CLAIM_BOUNDARY}"
      }
    }
  }
}
