{
  "action": "update_workspace",
  "rationale": "Register deterministic facts and their source artifact.",
  "basisRefs": ["${ARTIFACT_REF}"],
  "payload": {
    "append_evidence": {
      "schema_version": "ts-evidence/2",
      "node_id": "${NODE_ID}",
      "kind": "${EVIDENCE_KIND}",
      "evidence_tier": "local_parse",
      "summary": "${EVIDENCE_SUMMARY}",
      "facts": {},
      "artifact_refs": ["${ARTIFACT_REF}"],
      "provenance": {
        "producer": "${PRODUCER}",
        "producer_version": null,
        "source_sha256": null
      }
    }
  }
}
