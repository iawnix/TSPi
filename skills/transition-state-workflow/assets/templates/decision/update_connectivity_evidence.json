{
  "schema_version": "ts-decision",
  "action": "update_workspace",
  "rationale": "Register IRC or endpoint-assignment connectivity evidence.",
  "evidence_refs": [],
  "report_ref": {
    "report_id": "${REPORT_ID}",
    "workspace_root": "${WORKSPACE_ROOT}"
  },
  "payload": {
    "append_evidence": {
      "evidence_id": "${EV_CONNECTIVITY}",
      "kind": "irc_connectivity_validation",
      "role": "connectivity_gate",
      "evidence_tier": "local_parse",
      "node_id": "n003",
      "summary": "Forward and reverse IRC endpoints were assigned to the expected product and reactant basins. The primary evidence path is a connectivity artifact owned by this connectivity node.",
      "path": "${IRC_SUMMARY_PATH}",
      "source_files": [
        "${IRC_SUMMARY_PATH}"
      ],
      "source_sha256": "${SOURCE_SHA256}",
      "parser_name": "${CONNECTIVITY_PARSER_NAME}",
      "parser_version": "${PARSER_VERSION}",
      "normal_termination": true,
      "diagnostics": [],
      "quality": {
        "hypothesis_id": "${HYPOTHESIS_ID}",
        "prediction_ids": [
          "${PRED_CONN_ID}"
        ],
        "verdict_against_prediction": "supported",
        "strict_irc_complete": true,
        "irc_program_failures": [],
        "irc_directions": {
          "forward": {
            "normal_termination": true,
            "assignment": "product"
          },
          "reverse": {
            "normal_termination": true,
            "assignment": "reactant"
          }
        },
        "forward_assignment": "product",
        "reverse_assignment": "reactant",
        "endpoint_optimization_recovery_used": false
      },
      "facts": {
        "source_tsfreq_ref": "Record any upstream TS checkpoint/log consumed from the TS/Freq node in nodes/n003/outputs/artifact_manifest.json consumed_artifacts.",
        "reactant_endpoint_ref": "${IRC_REACTANT_ENDPOINT_REF}",
        "product_endpoint_ref": "${IRC_PRODUCT_ENDPOINT_REF}"
      }
    }
  }
}
