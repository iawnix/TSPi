#!/usr/bin/env bash

set -euo pipefail

readonly LAUNCHER_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly PACKAGE_ROOT="$(dirname -- "$LAUNCHER_PATH")"
readonly LAUNCHER_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly INSTALL_ROOT="${TS_AGENT_INSTALL_ROOT:-$LAUNCHER_DIR}"
readonly LAUNCHER="$PACKAGE_ROOT/scripts/tspi_launcher.py"

if [[ ! -f "$LAUNCHER" ]]; then
  printf 'TSPi: launcher is missing from the active package: %s\n' "$LAUNCHER" >&2
  exit 1
fi
exec python3 "$LAUNCHER" --install-root "$INSTALL_ROOT" -- "$@"
