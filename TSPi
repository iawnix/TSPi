#!/usr/bin/env bash

set -euo pipefail

readonly LAUNCHER_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly INSTALL_ROOT="$LAUNCHER_DIR"
readonly TS_WORKSPACES_ROOT="$INSTALL_ROOT/workspaces"
readonly TS_PACKAGE_ROOT="$INSTALL_ROOT/.pi/git/github.com/iawnix/TSAgentSkill"
readonly PI_BIN="${PI_BIN:-/home/iaw/.npm-global/bin/pi}"
readonly TS_REMOTE_CONFIG_DEFAULT="$INSTALL_ROOT/.pi/remote.toml"
readonly TS_NOTIFICATION_CONFIG_DEFAULT="$INSTALL_ROOT/.pi/notifications.toml"
readonly TS_AGENT_INSTALL_RUNTIME_HOME="$INSTALL_ROOT/.agents/runtime/transition-state-workflow"
readonly TS_AGENT_INSTALL_RUNTIME_MANIFEST="$TS_AGENT_INSTALL_RUNTIME_HOME/env.json"
readonly TS_AGENT_INSTALL_ENV_ROOT="$INSTALL_ROOT/.agents/envs/transition-state-workflow"

WORKSPACE_ROOT=""
ROOT_AGENT_LOCK_FD=""

configure_workspace_pi_settings() {
  local settings_path="$WORKSPACE_ROOT/.pi/settings.json"

  if [[ -L "$settings_path" ]]; then
    printf 'TSPi: workspace Pi settings cannot be a symbolic link: %s\n' "$settings_path" >&2
    return 1
  fi
  python3 - "$settings_path" <<'PY'
import json
import os
from pathlib import Path
import sys
import tempfile

path = Path(sys.argv[1])
try:
    settings = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
except (OSError, json.JSONDecodeError) as exc:
    raise SystemExit(f"TSPi: invalid workspace Pi settings: {path}: {exc}")
if not isinstance(settings, dict):
    raise SystemExit(f"TSPi: workspace Pi settings must contain a JSON object: {path}")
if settings.get("quietStartup") is True:
    raise SystemExit(0)

settings["quietStartup"] = True
temporary = None
try:
    descriptor, temporary = tempfile.mkstemp(prefix=".settings.", suffix=".tmp", dir=path.parent)
    with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
        json.dump(settings, handle, indent=2, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, path)
    temporary = None
finally:
    if temporary is not None:
        Path(temporary).unlink(missing_ok=True)
PY
}

usage() {
  cat <<'EOF'
Usage:
  ./TSPi --workspace <name> [--dev] [Pi arguments...]
  ./TSPi --check-remote

Each workspace name creates or reuses an isolated research directory under
./workspaces/. Only one Root Agent may write one workspace at a time.
Remote computation uses the installation-owned .pi/remote.toml profile.
EOF
}

prepare_workspace() {
  local workspace_name="$1"
  local requested_root
  local resolved_workspaces_root

  if [[ ! "$workspace_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$ ]]; then
    printf 'TSPi: invalid workspace name: %s\n' "$workspace_name" >&2
    printf 'TSPi: use 1-80 letters, digits, dots, underscores, or hyphens; start with a letter or digit\n' >&2
    return 1
  fi
  if [[ -L "$TS_WORKSPACES_ROOT" ]]; then
    printf 'TSPi: workspace container cannot be a symbolic link: %s\n' "$TS_WORKSPACES_ROOT" >&2
    return 1
  fi
  mkdir -p -- "$TS_WORKSPACES_ROOT"
  requested_root="$TS_WORKSPACES_ROOT/$workspace_name"
  if [[ -L "$requested_root" ]]; then
    printf 'TSPi: workspace cannot be a symbolic link: %s\n' "$requested_root" >&2
    return 1
  fi
  if [[ -e "$requested_root" && ! -d "$requested_root" ]]; then
    printf 'TSPi: workspace path is not a directory: %s\n' "$requested_root" >&2
    return 1
  fi
  if [[ ! -d "$requested_root" ]]; then
    mkdir -m 700 -- "$requested_root"
  fi
  resolved_workspaces_root="$(cd -- "$TS_WORKSPACES_ROOT" && pwd -P)"
  WORKSPACE_ROOT="$(cd -- "$requested_root" && pwd -P)"
  if [[ "$WORKSPACE_ROOT" != "$resolved_workspaces_root/"* ]]; then
    printf 'TSPi: resolved workspace escaped the installation workspace container: %s\n' "$WORKSPACE_ROOT" >&2
    return 1
  fi
  if [[ -L "$WORKSPACE_ROOT/.pi" || -L "$WORKSPACE_ROOT/.pi/sessions" ]]; then
    printf 'TSPi: workspace Pi state paths cannot be symbolic links: %s\n' "$WORKSPACE_ROOT" >&2
    return 1
  fi
  mkdir -p -- "$WORKSPACE_ROOT/.pi/sessions"
  chmod 700 -- "$WORKSPACE_ROOT/.pi"
  configure_workspace_pi_settings
}

acquire_root_agent_lock() {
  local lock_file="$WORKSPACE_ROOT/.pi/root-agent.lock"

  if [[ -L "$lock_file" ]]; then
    printf 'TSPi: Root Agent lock cannot be a symbolic link: %s\n' "$lock_file" >&2
    return 1
  fi
  exec {ROOT_AGENT_LOCK_FD}>>"$lock_file"
  if ! flock --nonblock "$ROOT_AGENT_LOCK_FD"; then
    printf 'TSPi: another Root Agent already owns workspace %s\n' "$WORKSPACE_ROOT" >&2
    printf 'TSPi: choose another --workspace name or stop the existing Root Agent\n' >&2
    return 1
  fi
  printf 'pid=%s\nstarted_at=%(%Y-%m-%dT%H:%M:%S%z)T\n' "$$" -1 > "$lock_file"
}

configure_remote() {
  if [[ -z "${TS_REMOTE_CONFIG:-}" && -f "$TS_REMOTE_CONFIG_DEFAULT" ]]; then
    export TS_REMOTE_CONFIG="$TS_REMOTE_CONFIG_DEFAULT"
  fi
  if [[ -z "${TS_REMOTE_CONFIG:-}" ]]; then
    export TS_REMOTE_DISPLAY_TARGET="not configured"
    return 0
  fi
  if [[ "$TS_REMOTE_CONFIG" != /* || ! -f "$TS_REMOTE_CONFIG" || -L "$TS_REMOTE_CONFIG" || ! -r "$TS_REMOTE_CONFIG" ]]; then
    printf 'TSPi: invalid TS_REMOTE_CONFIG: %s\n' "$TS_REMOTE_CONFIG" >&2
    return 1
  fi
  export TS_REMOTE_DISPLAY_TARGET="$(python3 - "$TS_REMOTE_CONFIG" <<'PY'
import sys
import tomllib

with open(sys.argv[1], "rb") as handle:
    config = tomllib.load(handle)
name = config.get("default_profile")
profile = config.get("profiles", {}).get(name, {})
host = profile.get("ssh_host", name or "configured")
scheduler = str(profile.get("scheduler", "torque")).title()
print(f"{host} · {scheduler}")
PY
)"
}

configure_notifications() {
  if [[ -z "${TS_NOTIFICATION_CONFIG:-}" && -f "$TS_NOTIFICATION_CONFIG_DEFAULT" ]]; then
    export TS_NOTIFICATION_CONFIG="$TS_NOTIFICATION_CONFIG_DEFAULT"
  fi
  if [[ -z "${TS_NOTIFICATION_CONFIG:-}" ]]; then
    unset TS_NOTIFICATION_CONFIG
    return 0
  fi
  if [[ "$TS_NOTIFICATION_CONFIG" != /* || ! -f "$TS_NOTIFICATION_CONFIG" || -L "$TS_NOTIFICATION_CONFIG" || ! -r "$TS_NOTIFICATION_CONFIG" ]]; then
    printf 'TSPi: invalid TS_NOTIFICATION_CONFIG: %s\n' "$TS_NOTIFICATION_CONFIG" >&2
    return 1
  fi
}

check_remote() {
  local output
  local status=0
  if [[ -z "${TS_REMOTE_CONFIG:-}" ]]; then
    printf 'TSPi: remote configuration is missing: %s\n' "$TS_REMOTE_CONFIG_DEFAULT" >&2
    return 1
  fi
  if output="$(python3 "$TS_PACKAGE_ROOT/scripts/ts_compute.py" remote-diagnostic --mode status)"; then
    status=0
  else
    status=$?
  fi
  if [[ $status -eq 0 ]] && python3 -c '
import json, sys
payload = json.load(sys.stdin)
raise SystemExit(0 if payload.get("ok") is True else 1)
' <<<"$output"; then
    printf 'TSPi: remote check passed (%s)\n' "$TS_REMOTE_DISPLAY_TARGET"
    return 0
  fi
  printf 'TSPi: remote check failed (%s)\n' "$TS_REMOTE_DISPLAY_TARGET" >&2
  if [[ -n "$output" ]]; then
    printf '%s\n' "$output" >&2
  fi
  return 1
}

main() {
  local check_remote_only=false
  local show_help=false
  local workspace_name=""
  local -a dev_extension_args=()
  local -a pi_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dev)
        dev_extension_args=(-e "$TS_PACKAGE_ROOT/extensions/ts-workflow-dev/index.ts")
        ;;
      --check-remote)
        check_remote_only=true
        ;;
      --workspace)
        shift
        if [[ $# -eq 0 || -z "$1" ]]; then
          printf 'TSPi: --workspace requires a name\n' >&2
          usage >&2
          return 2
        fi
        workspace_name="$1"
        ;;
      --workspace=*) workspace_name="${1#--workspace=}" ;;
      -h|--help) show_help=true ;;
      --)
        shift
        pi_args+=("$@")
        break
        ;;
      *) pi_args+=("$1") ;;
    esac
    shift
  done

  if [[ "$show_help" == true ]]; then
    usage
    return 0
  fi
  if [[ ! -d "$TS_PACKAGE_ROOT" ]]; then
    printf 'TSPi: TS package not found: %s\n' "$TS_PACKAGE_ROOT" >&2
    return 1
  fi
  configure_remote
  configure_notifications
  if [[ "$check_remote_only" == true ]]; then
    check_remote
    return
  fi
  if [[ ! -x "$PI_BIN" ]]; then
    printf 'TSPi: Pi executable not found: %s\n' "$PI_BIN" >&2
    return 127
  fi
  if [[ -z "$workspace_name" ]]; then
    printf 'TSPi: a research workspace is required\n' >&2
    usage >&2
    return 2
  fi

  prepare_workspace "$workspace_name"
  export TS_AGENT_RUNTIME_HOME="$TS_AGENT_INSTALL_RUNTIME_HOME"
  export TS_AGENT_RUNTIME_MANIFEST="$TS_AGENT_INSTALL_RUNTIME_MANIFEST"
  export TS_AGENT_ENV_ROOT="$TS_AGENT_INSTALL_ENV_ROOT"
  export TS_WORKSPACE_ROOT="$WORKSPACE_ROOT"
  acquire_root_agent_lock
  cd -- "$WORKSPACE_ROOT"

  exec "$PI_BIN" \
    --no-extensions \
    --no-skills \
    --skill "$TS_PACKAGE_ROOT/skills/transition-state-workflow" \
    --no-themes \
    --theme "$TS_PACKAGE_ROOT/themes/ts-theme.json" \
    --no-prompt-templates \
    -e "$TS_PACKAGE_ROOT/extensions/ts-workflow-control/index.ts" \
    -e "$TS_PACKAGE_ROOT/extensions/ts-workflow-ui/index.ts" \
    -e "$TS_PACKAGE_ROOT/extensions/ts-workflow-review/index.ts" \
    -e "$TS_PACKAGE_ROOT/extensions/ts-workflow-compute/index.ts" \
    -e "$TS_PACKAGE_ROOT/extensions/ts-workflow-artifacts/index.ts" \
    "${dev_extension_args[@]}" \
    --approve \
    --session-dir "$WORKSPACE_ROOT/.pi/sessions" \
    "${pi_args[@]}"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
