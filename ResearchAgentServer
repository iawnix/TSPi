#!/usr/bin/env bash

set -euo pipefail

readonly LAUNCHER_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly PACKAGE_ROOT="$(dirname -- "$LAUNCHER_PATH")"
readonly LAUNCHER_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ -n "${TSPI_INSTALL_ROOT:-}" ]]; then
  readonly INSTALL_ROOT="$TSPI_INSTALL_ROOT"
elif [[ "$(basename -- "$LAUNCHER_DIR")" == "bin" && -d "$(dirname -- "$LAUNCHER_DIR")/.pi/packages/tspi" ]]; then
  readonly INSTALL_ROOT="$(dirname -- "$LAUNCHER_DIR")"
else
  readonly INSTALL_ROOT="$LAUNCHER_DIR"
fi
readonly LAUNCHER="$PACKAGE_ROOT/apps/agent-cli/tspi_launcher.py"

if [[ ! -f "$LAUNCHER" ]]; then
  printf 'ResearchAgentServer: launcher is missing from the active package: %s\n' "$LAUNCHER" >&2
  exit 1
fi
# ResearchAgentServer is the public name for the installation Agent Server.
# Keep it on the exact same launcher path as ResearchAgent: the Host owns the
# Pi SDK runtime, sessions, and transports.  The old research_agent_launcher
# HTTP composition created a second runtime and is intentionally retired.
exec python3 "$LAUNCHER" --install-root "$INSTALL_ROOT" -- --service-host "$@"
