@@ -121,6 +125,7 @@ export class ExperimentalClientTui implements Component {
 	#recoveryTransition: Promise<void> = Promise.resolve();
 	#laneUnsubscribe: (() => void) | undefined;
 	#chatView: ExperimentalChatView | undefined;
+	#lastHistoryEntryId = 0;
 
 	private constructor(ui: TUI, requestRender: () => void, finish: () => void, loadedFacets: LoadedFacets) {
 		this.#ui = ui;
@@ -500,6 +504,20 @@ export class ExperimentalClientTui implements Component {
 		this.#documentContainer.addChild(view.transcript);
 		this.#pendingMessagesContainer.addChild(view.pendingMessages);
 		this.#laneUnsubscribe = feature.transcript.state.subscribe((value) => {
+			for (const entry of value.entries) {
+				if (entry.id <= this.#lastHistoryEntryId) continue;
+				this.#lastHistoryEntryId = entry.id;
+				const message = entry.model?.[0];
+				if (entry.kind !== "pi.user" || message?.role !== "user") continue;
+				const text =
+					typeof message.content === "string"
+						? message.content
+						: message.content
+								.filter((block) => block.type === "text")
+								.map((block) => block.text)
+								.join("");
+				this.#chatInput.addToHistory(text);
+			}
 			view.apply(value);
 			this.#rebuild();
 		});
