+const WORKSPACE_ROOT_ENV = "TSPI_WORKSPACE_ROOT";
+const WORKSPACE_NAME = /^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$/u;
+const execFileAsync = promisify(execFile);
+
+function resolveWorkspacePath(workspaceId: string): string {
+	if (!WORKSPACE_NAME.test(workspaceId)) throw new Error("workspaceId is invalid");
+	const rootValue = process.env[WORKSPACE_ROOT_ENV];
+	if (rootValue === undefined) throw new Error("TSPI_WORKSPACE_ROOT is not configured");
+	const root = resolvePath(rootValue);
+	const candidate = resolve(root, workspaceId);
+	const relativePath = relative(root, candidate);
+	if (relativePath !== workspaceId || relativePath.startsWith("..") || isAbsolute(relativePath)) {
+		throw new Error("workspaceId must name a direct workspace");
+	}
+	return candidate;
+}
+
+async function createWorkspaceRoot(workspaceId: string): Promise<WorkspaceSummary> {
+	const candidate = resolveWorkspacePath(workspaceId);
+	try {
+		await mkdir(candidate, { mode: 0o700 });
+	} catch (error) {
+		if (!(error instanceof Error && "code" in error && error.code === "EEXIST")) throw error;
+	}
+	const bootstrap = process.env.TSPI_WORKSPACE_BOOTSTRAP;
+	if (!bootstrap) throw new Error("TSPi workspace bootstrap command is not configured");
+	const python = process.env.TSPI_WORKSPACE_PYTHON || "python3";
+	await execFileAsync(python, [bootstrap, "bootstrap", "--root", candidate], { env: process.env });
+	const workspaces = await listWorkspaceRoots();
+	const result = workspaces.find((item) => item.workspaceId === workspaceId);
+	if (!result) throw new Error("workspace bootstrap did not register " + workspaceId);
+	return result;
+}
+
+async function resolveSessionCwd(requested: string | undefined, workspaceId?: string): Promise<string> {
+	const rootValue = process.env[WORKSPACE_ROOT_ENV];
+	const root = rootValue === undefined ? undefined : resolvePath(rootValue);
+	const candidate = workspaceId === undefined ? resolvePath(requested ?? process.cwd()) : resolveWorkspacePath(workspaceId);
+	if (root !== undefined) {
+		const relativePath = relative(root, candidate);
+		if (
+			relativePath === "" ||
+			relativePath.startsWith("..") ||
+			isAbsolute(relativePath) ||
+			relativePath.includes("/")
+		) {
+			throw new Error(`Session cwd must be inside ${WORKSPACE_ROOT_ENV}: ${candidate}`);
+		}
+	}
+	const info = await lstat(candidate);
+	if (!info.isDirectory() || info.isSymbolicLink()) {
+		throw new Error(`Session cwd must be a regular directory: ${candidate}`);
+	}
+	if (root !== undefined) {
+		try {
+			const identity = JSON.parse(await readFile(join(candidate, "workspace.json"), "utf8"));
+			if (identity?.schema_version !== "research-workspace/1") throw new Error("unsupported workspace schema");
+		} catch {
+			throw new RoutedServerError("service_invalid_value", `Session cwd is not a supported TSPi workspace: ${candidate}`);
+		}
+	}
+	return candidate;
+}
+
+async function listWorkspaceRoots(_context?: Context): Promise<WorkspaceSummary[]> {
+	const rootValue = process.env[WORKSPACE_ROOT_ENV];
+	if (rootValue === undefined) return [];
+	const root = resolvePath(rootValue);
+	const entries = await readdir(root, { withFileTypes: true });
+	const workspaces: WorkspaceSummary[] = [];
+	for (const entry of entries) {
+		if (!entry.isDirectory() || entry.isSymbolicLink() || !WORKSPACE_NAME.test(entry.name)) continue;
+		const workspaceRoot = resolve(root, entry.name);
+		try {
+			const info = await stat(workspaceRoot);
+			if (!info.isDirectory()) continue;
+			const identity = JSON.parse(await readFile(join(workspaceRoot, "workspace.json"), "utf8"));
+			if (identity?.schema_version !== "research-workspace/1") continue;
+		} catch {
+			continue;
+		}
+		workspaces.push({ workspaceId: entry.name, name: entry.name, root: workspaceRoot });
+	}
+	return workspaces.sort((left, right) => left.name.localeCompare(right.name));
+}
