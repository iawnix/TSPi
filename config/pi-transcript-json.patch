+function toStrictJson<T>(value: T): T {
+	if (isJsonValue(value)) return value;
+	let encoded: string | undefined;
+	try {
+		encoded = JSON.stringify(value);
+	} catch (error) {
+		throw new TypeError("Transcript value is not JSON serializable", { cause: error });
+	}
+	if (encoded === undefined) throw new TypeError("Transcript value is not JSON serializable");
+	const normalized: unknown = JSON.parse(encoded);
+	if (!isJsonValue(normalized)) throw new TypeError("Transcript value is not strict JSON");
+	return normalized as T;
+}
