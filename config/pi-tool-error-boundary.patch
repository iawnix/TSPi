+/**
+ * Route validation and policy outcomes through the same post-tool adapter as
+ * executed tools. These outcomes never cross the external effect boundary, but
+ * they still need durable error envelopes and the normal transcript contract.
+ */
+async function finalizeImmediateToolOutcome<TContext extends object | undefined>(
+	lane: Lane<TContext>,
+	drive: Drive,
+	outcome: ToolOutcome,
+	options: { recovery?: boolean; replay?: "never" | "safe" } = {},
+): Promise<ToolOutcome> {
+	const result = outcome.message;
+	const patch = await lane.hooks.runToolWithGate(
+		"after_tool",
+		{
+			lane: lane.name,
+			runId: drive.operationId,
+			toolCallId: outcome.toolCall.id,
+			toolName: outcome.toolCall.name,
+			args: outcome.toolCall.arguments,
+			content: result.content,
+			...(result.details === undefined ? {} : { details: result.details }),
+			isError: true,
+			...(options.recovery === true ? { recovery: true as const } : {}),
+			...(options.replay === undefined ? {} : { replay: options.replay }),
+		},
+		drive.gate,
+		drive.context,
+	);
+	if (!patch) return outcome;
+	return {
+		...outcome,
+		message: {
+			...result,
+			content: patch.content ?? result.content,
+			...(patch.details === undefined
+				? result.details === undefined ? {} : { details: result.details }
+				: { details: patch.details }),
+			isError: patch.isError ?? result.isError,
+		},
+		terminate: patch.terminate ?? outcome.terminate,
+	};
+}
