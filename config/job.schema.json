{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job installation configuration",
  "type": "object",
  "required": [
    "default_environment",
    "environments"
  ],
  "properties": {
    "default_environment": {
      "type": "string"
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "local",
              "remote"
            ]
          },
          "python": {
            "$ref": "#/$defs/python"
          },
          "backends": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "python": {
                  "$ref": "#/$defs/python"
                },
                "command": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  ]
                },
                "activation_script": {
                  "type": "string",
                  "pattern": "^/"
                },
                "submission": {
                  "$ref": "#/$defs/submission"
                }
              },
              "anyOf": [
                {
                  "required": [
                    "command"
                  ]
                },
                {
                  "required": [
                    "python"
                  ]
                }
              ]
            }
          },
          "submission": {
            "$ref": "#/$defs/submission"
          }
        }
      },
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      }
    }
  },
  "$defs": {
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manager",
        "conda_executable",
        "prefix",
        "lock_ref"
      ],
      "properties": {
        "manager": {
          "const": "conda"
        },
        "conda_executable": {
          "type": "string",
          "pattern": "^/"
        },
        "prefix": {
          "type": "string",
          "pattern": "^/"
        },
        "lock_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "queue": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.@-]+$"
        },
        "queue_wait_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object",
          "properties": {
            "cpus": {
              "type": "integer",
              "minimum": 1
            },
            "memory_mb": {
              "type": "integer",
              "minimum": 1
            },
            "walltime": {
              "type": "string",
              "pattern": "^[0-9]+:[0-5][0-9]:[0-5][0-9]$"
            },
            "select": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
