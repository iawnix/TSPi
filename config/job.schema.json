{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job installation configuration",
  "type": "object",
  "properties": {
    "default_environment": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "local",
              "remote"
            ]
          },
          "python": {
            "type": "object",
            "properties": {
              "manager": {
                "const": "conda"
              },
              "conda_executable": {
                "type": "string",
                "minLength": 1,
                "pattern": "^/(?!$)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\n\\r\\u0000]+$"
              },
              "prefix": {
                "type": "string",
                "minLength": 1,
                "pattern": "^/(?!$)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\n\\r\\u0000]+$"
              },
              "lock_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "^/(?!$)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\n\\r\\u0000]+$"
              }
            },
            "required": [
              "manager",
              "conda_executable",
              "prefix",
              "lock_ref"
            ],
            "additionalProperties": false
          },
          "submission": {
            "type": "object",
            "properties": {
              "queue": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}$"
              },
              "queue_wait_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "resources": {
                "type": "object",
                "properties": {
                  "cpus": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "memory_mb": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "walltime": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!0+:00:00$)[0-9]+:[0-5][0-9]:[0-5][0-9]$"
                  },
                  "select": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_=:+.-]+$"
                  }
                },
                "required": [],
                "additionalProperties": false,
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "select",
                        "cpus"
                      ]
                    },
                    {
                      "required": [
                        "select",
                        "memory_mb"
                      ]
                    }
                  ]
                }
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "backends": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "command": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  ]
                },
                "python": {
                  "type": "object",
                  "properties": {
                    "manager": {
                      "const": "conda"
                    },
                    "conda_executable": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^/(?!$)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\n\\r\\u0000]+$"
                    },
                    "prefix": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^/(?!$)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\n\\r\\u0000]+$"
                    },
                    "lock_ref": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^/(?!$)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\n\\r\\u0000]+$"
                    }
                  },
                  "required": [
                    "manager",
                    "conda_executable",
                    "prefix",
                    "lock_ref"
                  ],
                  "additionalProperties": false
                },
                "activation_script": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^/(?!$)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\n\\r\\u0000]+$"
                },
                "scratch_root": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^/(?!$)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\n\\r\\u0000]+$"
                },
                "allowed_queues": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}$"
                  }
                },
                "submission": {
                  "type": "object",
                  "properties": {
                    "queue": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}$"
                    },
                    "queue_wait_seconds": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "resources": {
                      "type": "object",
                      "properties": {
                        "cpus": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "memory_mb": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "walltime": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^(?!0+:00:00$)[0-9]+:[0-5][0-9]:[0-5][0-9]$"
                        },
                        "select": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[A-Za-z0-9_=:+.-]+$"
                        }
                      },
                      "required": [],
                      "additionalProperties": false,
                      "not": {
                        "anyOf": [
                          {
                            "required": [
                              "select",
                              "cpus"
                            ]
                          },
                          {
                            "required": [
                              "select",
                              "memory_mb"
                            ]
                          }
                        ]
                      }
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "environment": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[^\\u0000]*$"
                  }
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "ssh_host": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$"
          },
          "ssh_config": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/(?!$)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\n\\r\\u0000]+$"
          },
          "scheduler": {
            "enum": [
              "torque",
              "pbs"
            ]
          },
          "remote_root": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/(?!$)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\n\\r\\u0000]+$"
          },
          "allowed_queues": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}$"
            }
          },
          "connect_timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          },
          "command_timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "transfer_timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "commands": {
            "type": "object",
            "properties": {
              "qsub": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S+$"
              },
              "qstat": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S+$"
              },
              "qdel": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S+$"
              },
              "checkjob": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S+$"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "remote"
                }
              }
            },
            "then": {
              "required": [
                "ssh_host",
                "remote_root"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "allowed_queues"
                    ]
                  },
                  {
                    "required": [
                      "command_timeout_seconds"
                    ]
                  },
                  {
                    "required": [
                      "commands"
                    ]
                  },
                  {
                    "required": [
                      "connect_timeout_seconds"
                    ]
                  },
                  {
                    "required": [
                      "remote_root"
                    ]
                  },
                  {
                    "required": [
                      "scheduler"
                    ]
                  },
                  {
                    "required": [
                      "ssh_config"
                    ]
                  },
                  {
                    "required": [
                      "ssh_host"
                    ]
                  },
                  {
                    "required": [
                      "transfer_timeout_seconds"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "not": {
                "required": [
                  "python"
                ]
              }
            },
            "then": {
              "properties": {
                "backends": {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "required": [
                          "command"
                        ]
                      },
                      {
                        "required": [
                          "python"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "local"
                }
              }
            },
            "then": {
              "properties": {
                "submission": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "queue"
                        ]
                      },
                      {
                        "required": [
                          "queue_wait_seconds"
                        ]
                      }
                    ]
                  }
                },
                "backends": {
                  "additionalProperties": {
                    "properties": {
                      "submission": {
                        "not": {
                          "anyOf": [
                            {
                              "required": [
                                "queue"
                              ]
                            },
                            {
                              "required": [
                                "queue_wait_seconds"
                              ]
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "remote"
                },
                "scheduler": {
                  "const": "pbs"
                }
              },
              "required": [
                "scheduler"
              ]
            },
            "else": {
              "properties": {
                "submission": {
                  "properties": {
                    "resources": {
                      "not": {
                        "required": [
                          "select"
                        ]
                      }
                    }
                  }
                },
                "backends": {
                  "additionalProperties": {
                    "properties": {
                      "submission": {
                        "properties": {
                          "resources": {
                            "not": {
                              "required": [
                                "select"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "default_environment",
    "environments"
  ],
  "additionalProperties": false
}
