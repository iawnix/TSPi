+const WORKSPACE_MANIFEST_SCHEMA = "research_agent_workspace_1";
+const RESEARCH_WORKSPACE_DIRECTORIES = Object.freeze([
+	"inputs", "artifacts", "runs", "logs", "research_map", "memory", "lifecycle",
+	"checkpoints", "nodes", "evidence", "monitor", "environments",
+]);
+
+async function isSupportedResearchAgentWorkspace(root: string, manifest: unknown): Promise<boolean> {
+	if (!manifest || typeof manifest !== "object" || Array.isArray(manifest)) return false;
+	const value = manifest as Record<string, unknown>;
+	const kernel = value.research_kernel;
+	if (
+		value.schema_version !== WORKSPACE_MANIFEST_SCHEMA
+		|| value.workspace_mode !== "research"
+		|| value.state !== "ready"
+		|| typeof value.workspace_id !== "string"
+		|| !WORKSPACE_NAME.test(value.workspace_id)
+		|| value.workspace_root !== root
+		|| typeof value.created_at !== "string"
+		|| value.created_at.length === 0
+		|| !Array.isArray(value.directories)
+		|| !RESEARCH_WORKSPACE_DIRECTORIES.every((directory) => value.directories.includes(directory))
+		|| !kernel || typeof kernel !== "object" || Array.isArray(kernel)
+		|| (kernel as Record<string, unknown>).initialized !== true
+		|| (kernel as Record<string, unknown>).admission_required !== false
+		|| !Number.isInteger((kernel as Record<string, unknown>).revision)
+		|| ((kernel as Record<string, unknown>).revision as number) < 0
+	) return false;
+	try {
+		for (const directory of RESEARCH_WORKSPACE_DIRECTORIES) {
+			const info = await lstat(join(root, directory));
+			if (info.isSymbolicLink() || !info.isDirectory()) return false;
+		}
+		const context = JSON.parse(await readFile(join(root, "research_map/context.json"), "utf8"));
+		const liveness = JSON.parse(await readFile(join(root, "lifecycle/liveness.json"), "utf8"));
+		const revision = (kernel as Record<string, unknown>).revision;
+		return context?.schema_version === "research_map_context_1"
+			&& context?.workspace_id === value.workspace_id
+			&& context?.workspace_mode === "research"
+			&& context?.lifecycle_state === "admitted"
+			&& context?.revision === revision
+			&& liveness?.schema_version === "research_liveness_1"
+			&& liveness?.workspace_id === value.workspace_id
+			&& liveness?.state === "admitted"
+			&& liveness?.revision === revision;
+	} catch {
+		return false;
+	}
+}
