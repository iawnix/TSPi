+function sessionUserTexts(entries: readonly Entry[]): readonly string[] {
+	const texts: string[] = [];
+	const add = (message: AgentMessage): void => {
+		if (message.role !== "user") return;
+		const text = typeof message.content === "string"
+			? message.content
+			: message.content
+				.filter((content) => content.type === "text")
+				.map((content) => content.text)
+				.join("");
+		if (text.trim().length > 0) texts.push(text);
+	};
+	for (const entry of entries) {
+		if (entry.type === "message") add(entry.message);
+		else if (entry.type === "compaction") for (const message of entry.retainedTail) add(message);
+	}
+	return texts;
+}
