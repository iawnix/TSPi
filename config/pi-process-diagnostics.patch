+						...process.env,
+						...options.env,
+						[INTERNAL_PROCESS_ENV]: role,
+					},
+					stdio: diagnosticFd === undefined ? "ignore" : ["ignore", "ignore", diagnosticFd],
+					windowsHide: true,
+				},
+			);
+		} finally {
