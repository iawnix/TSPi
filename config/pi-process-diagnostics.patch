+	// Detached Pi processes normally discard stderr. TSPi can opt into a
+	// per-run diagnostic file without changing the default process contract.
+	const diagnosticPath = process.env.TSPI_PI_DIAGNOSTIC_FILE?.trim();
+	let diagnosticFd: number | undefined;
+	if (diagnosticPath) {
+		try {
+			diagnosticFd = openSync(diagnosticPath, "a", 0o600);
+		} catch {
+			// Diagnostics must never prevent the managed process from starting.
+		}
+	}
+	const child = (() => {
+		try {
+			return spawn(
