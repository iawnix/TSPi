{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "research-agent-execution/1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "executors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "backend": {
            "type": "string",
            "minLength": 1
          },
          "runtime": {
            "enum": [
              "python",
              "native"
            ]
          },
          "entry": {
            "type": "string",
            "minLength": 1
          },
          "cli": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "inputs": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                },
                "min_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "media_type": {
                  "type": "string",
                  "minLength": 1
                },
                "recursive": {
                  "type": "boolean"
                }
              },
              "required": [
                "path",
                "required",
                "min_bytes"
              ],
              "additionalProperties": false
            }
          },
          "requirements": {
            "type": "object",
            "properties": {
              "python": {
                "type": "string",
                "minLength": 1
              },
              "packages": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "imports": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*$"
                },
                "uniqueItems": true
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "resources": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "module_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "version",
          "backend",
          "runtime",
          "argv",
          "inputs",
          "outputs",
          "resources"
        ],
        "additionalProperties": false
      }
    },
    "validators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "backend": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "resources": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "input_contract": {
            "type": "object",
            "properties": {
              "schema_version": {
                "const": "validator-input/1"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "enum": [
                        "registered_artifact",
                        "collected_output"
                      ]
                    },
                    "schema_version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "max_bytes": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "name",
                    "source"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "schema_version",
              "roles"
            ],
            "additionalProperties": false
          },
          "requirements": {
            "type": "object",
            "properties": {
              "python": {
                "type": "string",
                "minLength": 1
              },
              "packages": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "imports": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*$"
                },
                "uniqueItems": true
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "module_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "version",
          "backend",
          "entry",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "acceptance_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "validator_result",
                    "registered_artifact"
                  ]
                },
                "validator_id": {
                  "type": "string",
                  "minLength": 1
                },
                "validator_version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "kind"
              ],
              "additionalProperties": false,
              "if": {
                "properties": {
                  "kind": {
                    "const": "validator_result"
                  }
                }
              },
              "then": {
                "required": [
                  "validator_id",
                  "validator_version"
                ]
              }
            },
            "minItems": 1
          },
          "subject_binding": {
            "type": "string",
            "minLength": 1
          },
          "binding_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "constraint_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "version",
          "checks"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "name",
    "version",
    "executors",
    "validators",
    "acceptance_profiles"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
