{
  "schema_version": "tspi-provider-descriptor/1",
  "provider_id": "chemical.comparison.plan",
  "kind": "harness",
  "capabilities": [
    {
      "id": "chemical.comparison.plan",
      "version": "1"
    }
  ],
  "implementation": "adapter",
  "notes": "Pure method x environment x opt/sp planning; execution is delegated to compute_run.",
  "operation": "chemical.comparison.plan",
  "version": "1",
  "input_schema": {
    "type": "object",
    "required": ["input_artifact"],
    "properties": {
      "input_artifact": {"type": "string", "pattern": "^art_[0-9a-f]{64}$"}
    },
    "additionalProperties": false
  },
  "parameter_schema": {
    "type": "object",
    "properties": {
      "methods": {"type": "array", "items": {"type": "string"}, "minItems": 1},
      "environments": {"type": "array", "items": {"type": "string"}, "minItems": 1},
      "readiness": {"type": "object"}
    },
    "additionalProperties": false
  },
  "result_schema": {
    "type": "object",
    "required": ["schema_version", "jobs"],
    "properties": {
      "schema_version": {"const": "chemical_computation_plan/1"},
      "jobs": {"type": "array"}
    },
    "additionalProperties": true
  },
  "output_roles": ["computation_plan"],
  "effects": [],
  "limits": {"timeout_seconds": 30, "max_jobs": 128}
}
