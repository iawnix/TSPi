{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS compact claim-scoped review provider input",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "operation",
    "objective",
    "scope",
    "workspace_revision",
    "target_claim_ref",
    "claims",
    "gate_results",
    "evidence",
    "nodes",
    "artifact_excerpts",
    "basis_allowlist"
  ],
  "properties": {
    "schema_version": {"const": "ts-review-provider-input/2"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "operation": {"const": "claim_review"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "scope": {"$ref": "agent_task.schema.json#/$defs/scope"},
    "workspace_revision": {"type": ["string", "null"]},
    "target_claim_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "claims": {"type": "array", "maxItems": 8, "items": {"type": "object"}},
    "gate_results": {"type": "array", "maxItems": 32, "items": {"type": "object"}},
    "evidence": {"type": "array", "maxItems": 32, "items": {"type": "object"}},
    "nodes": {"type": "array", "maxItems": 16, "items": {"type": "object"}},
    "artifact_excerpts": {
      "type": "array",
      "maxItems": 4,
      "items": {"$ref": "review_evidence_snapshot.schema.json#/$defs/artifactExcerpt"}
    },
    "basis_allowlist": {
      "type": "array",
      "description": "Set of citable refs; host-generated provider inputs serialize it in lexicographic order.",
      "uniqueItems": true,
      "maxItems": 80,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    }
  },
  "additionalProperties": false
}
