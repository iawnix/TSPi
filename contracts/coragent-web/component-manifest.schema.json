{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coragent.iawnix.xyz/schema/coragent-web-component-manifest-v1.json",
  "title": "CoRAgent Web component release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "component", "protocols", "entrypoint", "archive", "source", "created_at_utc"],
  "properties": {
    "schema_version": { "const": "coragent-web-component-release/1" },
    "release_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$" },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "coragent-web" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "protocols": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "snapshot", "theme"],
      "properties": {
        "provider": { "const": "research-memory-provider/1" },
        "snapshot": { "const": "research-snapshot/2" },
        "theme": { "const": "coragent-theme/1" }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": { "path": { "const": "bin/coragent-web" } }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "size_bytes"],
      "properties": {
        "filename": { "type": "string", "pattern": "^coragent-web-component-[A-Za-z0-9][A-Za-z0-9._-]{0,159}\\.tgz$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "dirty"],
      "properties": {
        "git_commit": { "type": ["string", "null"] },
        "dirty": { "type": "boolean" }
      }
    },
    "created_at_utc": { "type": "string", "minLength": 1 }
  }
}
