{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iawnix:ts-agent-task:2",
  "title": "TS isolated agent task",
  "type": "object",
  "required": ["schema_version", "task_id", "role", "authority", "operation", "objective", "workspace", "scope", "inputs", "capabilities", "constraints", "output_contract"],
  "properties": {
    "schema_version": {"const": "ts-agent-task/2"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "role": {"const": "review"},
    "authority": {"const": "advisory"},
    "operation": {"type": "string", "minLength": 1, "maxLength": 128},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "workspace": {
      "type": "object",
      "required": ["root", "report_id", "revision"],
      "properties": {
        "root": {"type": "string", "minLength": 1, "maxLength": 4096},
        "report_id": {"type": ["string", "null"]},
        "revision": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "scope": {"$ref": "#/$defs/scope"},
    "inputs": {
      "type": "object",
      "required": ["review_snapshot", "provider_input"],
      "properties": {
        "review_snapshot": {"$ref": "#/$defs/reviewSnapshotBinding"},
        "provider_input": {"$ref": "#/$defs/providerInputBinding"}
      },
      "additionalProperties": false
    },
    "capabilities": {"type": "array", "uniqueItems": true, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "constraints": {
      "type": "object",
      "required": ["canonical_workspace_mutation", "scientific_decision", "recursive_delegation", "remote_authority", "external_side_effects"],
      "properties": {
        "canonical_workspace_mutation": {"const": false},
        "scientific_decision": {"const": false},
        "recursive_delegation": {"const": false},
        "remote_authority": {"const": "execution_mirror"},
        "external_side_effects": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "output_contract": {"const": "ts-agent-result/1"}
  },
  "additionalProperties": false,
  "$defs": {
    "documentBinding": {
      "type": "object",
      "required": ["ref", "schema_version", "sha256", "bytes"],
      "properties": {
        "ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "schema_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
      },
      "additionalProperties": false
    },
    "reviewSnapshotBinding": {
      "allOf": [
        {"$ref": "#/$defs/documentBinding"},
        {"properties": {"ref": {"const": "review-snapshot.json"}, "schema_version": {"const": "ts-review-task-snapshot/2"}}}
      ]
    },
    "providerInputBinding": {
      "allOf": [
        {"$ref": "#/$defs/documentBinding"},
        {"properties": {"ref": {"const": "provider-input.json"}, "schema_version": {"const": "ts-review-provider-input/4"}}}
      ]
    },
    "scope": {
      "type": "object",
      "required": ["report_id", "act_refs", "claim_refs"],
      "properties": {
        "report_id": {"type": ["string", "null"]},
        "act_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "claim_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  }
}
