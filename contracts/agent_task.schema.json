{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iawnix:ts-agent-task:2",
  "title": "TS isolated agent task",
  "type": "object",
  "required": ["schema_version", "task_id", "role", "authority", "operation", "objective", "workspace", "scope", "inputs", "capabilities", "constraints", "output_contract"],
  "properties": {
    "schema_version": {"const": "ts-agent-task/2"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "role": {"enum": ["review", "compute"]},
    "authority": {"enum": ["advisory", "operational"]},
    "operation": {"type": "string", "minLength": 1, "maxLength": 128},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "workspace": {
      "type": "object",
      "required": ["root", "report_id", "revision"],
      "properties": {
        "root": {"type": "string", "minLength": 1, "maxLength": 4096},
        "report_id": {"type": ["string", "null"]},
        "revision": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "scope": {"$ref": "#/$defs/scope"},
    "inputs": {"oneOf": [{"$ref": "#/$defs/reviewInputs"}, {"$ref": "#/$defs/computeInputs"}]},
    "capabilities": {"type": "array", "uniqueItems": true, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "constraints": {
      "type": "object",
      "required": ["canonical_workspace_mutation", "scientific_decision", "recursive_delegation", "remote_authority", "external_side_effects"],
      "properties": {
        "canonical_workspace_mutation": {"const": false},
        "scientific_decision": {"const": false},
        "recursive_delegation": {"const": false},
        "remote_authority": {"const": "execution_mirror"},
        "external_side_effects": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "output_contract": {"const": "ts-agent-result/1"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "review"}}},
      "then": {
        "properties": {
          "authority": {"const": "advisory"},
          "operation": {"const": "claim_review"},
          "inputs": {"$ref": "#/$defs/reviewInputs"}
        }
      }
    },
    {
      "if": {"properties": {"role": {"const": "compute"}}},
      "then": {
        "properties": {
          "authority": {"const": "operational"},
          "operation": {"enum": ["launch", "inspect", "finalize", "cancel"]},
          "inputs": {"$ref": "#/$defs/computeInputs"}
        }
      }
    },
    {
      "if": {"properties": {"role": {"const": "compute"}, "operation": {"const": "launch"}}, "required": ["role", "operation"]},
      "then": {"properties": {"inputs": {"properties": {"required_actions": {"const": ["prepare", "submit"]}, "optional_actions": {"const": []}, "tail": {"const": null}, "collect_artifacts": {"const": []}, "parse_artifact_ref": {"const": null}}}}}
    },
    {
      "if": {"properties": {"role": {"const": "compute"}, "operation": {"const": "inspect"}}, "required": ["role", "operation"]},
      "then": {"properties": {"inputs": {"properties": {"required_actions": {"const": ["status"]}, "optional_actions": {"const": ["tail"]}, "tail": {"$ref": "#/$defs/computeTail"}, "collect_artifacts": {"const": []}, "parse_artifact_ref": {"const": null}}}}}
    },
    {
      "if": {"properties": {"role": {"const": "compute"}, "operation": {"const": "finalize"}}, "required": ["role", "operation"]},
      "then": {"properties": {"inputs": {"properties": {"required_actions": {"const": ["collect", "parse"]}, "optional_actions": {"const": []}, "tail": {"const": null}, "parse_artifact_ref": {"type": "string", "minLength": 1, "maxLength": 4096}}}}}
    },
    {
      "if": {"properties": {"role": {"const": "compute"}, "operation": {"const": "cancel"}}, "required": ["role", "operation"]},
      "then": {"properties": {"inputs": {"properties": {"required_actions": {"const": ["cancel"]}, "optional_actions": {"const": []}, "tail": {"const": null}, "collect_artifacts": {"const": []}, "parse_artifact_ref": {"const": null}}}}}
    }
  ],
  "$defs": {
    "documentBinding": {
      "type": "object",
      "required": ["ref", "schema_version", "sha256", "bytes"],
      "properties": {
        "ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "schema_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
      },
      "additionalProperties": false
    },
    "reviewSnapshotBinding": {
      "allOf": [
        {"$ref": "#/$defs/documentBinding"},
        {"properties": {"ref": {"const": "review-snapshot.json"}, "schema_version": {"const": "ts-review-task-snapshot/3"}}}
      ]
    },
    "providerInputBinding": {
      "allOf": [
        {"$ref": "#/$defs/documentBinding"},
        {"properties": {"ref": {"const": "provider-input.json"}, "schema_version": {"const": "ts-review-provider-input/5"}}}
      ]
    },
    "reviewInputs": {
      "type": "object",
      "required": ["review_snapshot", "provider_input"],
      "properties": {
        "review_snapshot": {"$ref": "#/$defs/reviewSnapshotBinding"},
        "provider_input": {"$ref": "#/$defs/providerInputBinding"}
      },
      "additionalProperties": false
    },
    "computeTail": {
      "type": "object",
      "required": ["artifact", "lines"],
      "properties": {
        "artifact": {"type": ["string", "null"], "maxLength": 255},
        "lines": {"type": "integer", "minimum": 1, "maximum": 500}
      },
      "additionalProperties": false
    },
    "computeInputs": {
      "type": "object",
      "required": ["backend", "node_id", "intent_id", "intent_digest", "execution_kind", "required_actions", "optional_actions", "tail", "collect_artifacts", "parse_artifact_ref"],
      "properties": {
        "backend": {"type": "string", "minLength": 1, "maxLength": 64},
        "node_id": {"type": "string", "pattern": "^node_[1-9][0-9]*$", "maxLength": 128},
        "intent_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{5,127}$"},
        "intent_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "execution_kind": {"const": "remote"},
        "required_actions": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["prepare", "submit", "status", "tail", "collect", "parse", "cancel"]}},
        "optional_actions": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["prepare", "submit", "status", "tail", "collect", "parse", "cancel"]}},
        "tail": {"oneOf": [{"$ref": "#/$defs/computeTail"}, {"type": "null"}]},
        "collect_artifacts": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 255}},
        "parse_artifact_ref": {"type": ["string", "null"], "maxLength": 4096}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["report_id", "node_refs", "claim_refs"],
      "properties": {
        "report_id": {"type": ["string", "null"]},
        "node_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "claim_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  }
}
