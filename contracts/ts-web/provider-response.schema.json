{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tspi.iawnix.xyz/schema/ts-web-provider-response-v1.json",
  "title": "TSPi TS Web provider response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "ok"],
  "properties": {
    "schema_version": { "const": "ts-research-provider/1" },
    "request_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$" },
    "ok": { "type": "boolean" },
    "payload": {},
    "error": { "$ref": "error.schema.json" }
  },
  "oneOf": [
    { "properties": { "ok": { "const": true } }, "required": ["payload"] },
    { "properties": { "ok": { "const": false } }, "required": ["error"] }
  ]
}
