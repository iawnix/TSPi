{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent.iawnix.xyz/schema/research-memory-provider-response-v1.json",
  "title": "Research memory provider response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "ok"],
  "properties": {
    "schema_version": { "const": "research-memory-provider/1" },
    "request_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$" },
    "ok": { "type": "boolean" },
    "payload": {},
    "error": { "$ref": "https://research-agent.iawnix.xyz/schema/research-memory-error-v1.json" }
  },
  "oneOf": [
    { "properties": { "ok": { "const": true } }, "required": ["payload"] },
    { "properties": { "ok": { "const": false } }, "required": ["error"] }
  ]
}
