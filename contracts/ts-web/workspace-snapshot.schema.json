{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tspi.iawnix.xyz/schema/research-map-response-v1.json",
  "title": "Canonical ResearchMap response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace", "map", "changed"],
  "properties": {
    "schema_version": { "const": "research-map-response/1" },
    "changed": { "type": "boolean" },
    "workspace": { "type": "object" },
    "map": {
      "type": "object",
      "required": ["schema_version", "map_id", "title", "revision", "phases", "claims", "nodes", "findings", "gates", "progress"],
      "properties": {
        "schema_version": { "const": "research-map/1" },
        "map_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 },
        "phases": { "type": "array" },
        "claims": { "type": "array" },
        "nodes": { "type": "array" },
        "findings": { "type": "array" },
        "gates": { "type": "array" },
        "progress": { "type": "object" }
      }
    }
  }
}
