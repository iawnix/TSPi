{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tspi.iawnix.xyz/schema/tspi-extension-manifest-v1.json",
  "title": "TSPi installed extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "const": "tspi-extension/1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "server": {
      "$ref": "#/$defs/server"
    },
    "validators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "entry",
          "sha256",
          "backend"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "entry": {
            "$ref": "#/$defs/relative_path"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "input_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema_version",
              "roles"
            ],
            "properties": {
              "schema_version": {
                "const": "validator-input/1"
              },
              "roles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "source"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "enum": [
                        "registered_artifact",
                        "collected_output"
                      ]
                    },
                    "schema_version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "max_bytes": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          },
          "resources": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/relative_path"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "$ref": "#/$defs/relative_path"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          },
          "backend": {
            "type": "string",
            "minLength": 1
          },
          "requirements": {
            "$ref": "#/$defs/execution_requirements"
          }
        }
      }
    },
    "acceptance_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "checks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "subject_binding": {
            "type": "string",
            "minLength": 1
          },
          "binding_keys": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "constraint_keys": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "validator_result",
                    "registered_artifact"
                  ]
                },
                "validator_id": {
                  "type": "string",
                  "minLength": 1
                },
                "validator_version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "validator_result"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "validator_id",
                      "validator_version"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "executors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/executor"
      }
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "resources_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "sha256",
        "tools",
        "permissions"
      ],
      "properties": {
        "entry": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "workspace.read",
              "workspace.write",
              "remote.submit",
              "model.delegate",
              "notify.send"
            ]
          }
        }
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "skill",
        "backend",
        "runtime",
        "argv",
        "inputs",
        "outputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "enum": [
            "python",
            "native"
          ]
        },
        "entry": {
          "$ref": "#/$defs/relative_path"
        },
        "cli": {
          "$ref": "#/$defs/relative_path"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/relative_path"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "required",
              "min_bytes"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/relative_path"
              },
              "required": {
                "type": "boolean"
              },
              "min_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "media_type": {
                "type": "string",
                "minLength": 1
              },
              "recursive": {
                "type": "boolean"
              }
            }
          }
        },
        "requirements": {
          "$ref": "#/$defs/execution_requirements"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "runtime": {
                "const": "python"
              }
            }
          },
          "then": {
            "required": [
              "entry"
            ]
          },
          "else": {
            "not": {
              "required": [
                "entry"
              ]
            },
            "properties": {
              "requirements": {
                "maxProperties": 0
              }
            }
          }
        }
      ]
    },
    "execution_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "packages": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "imports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*$"
          }
        }
      }
    }
  }
}
