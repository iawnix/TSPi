{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tspi.iawnix.xyz/schema/tspi-provider-descriptor-v1.json",
  "title": "TSPi capability provider descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "kind", "capabilities", "implementation"],
  "properties": {
    "schema_version": {"const": "tspi-provider-descriptor/1"},
    "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-._][a-z0-9]+)*$"},
    "kind": {"enum": ["compute", "analysis", "harness", "notification"]},
    "implementation": {"enum": ["builtin", "adapter"]},
    "notes": {"type": "string", "maxLength": 1000},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"}
          }
        }
      }
    }
  }
}
