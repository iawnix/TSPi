{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS claim-scoped review evidence snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "operation",
    "scope",
    "target_claim_ref",
    "workspace_revision",
    "claims",
    "gate_results",
    "evidence",
    "nodes",
    "artifact_excerpts",
    "basis_allowlist"
  ],
  "properties": {
    "schema_version": {"const": "ts-review-evidence-snapshot/2"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "operation": {"const": "claim_review"},
    "scope": {"$ref": "agent_task.schema.json#/$defs/scope"},
    "target_claim_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "workspace_revision": {"type": ["string", "null"]},
    "claims": {"type": "array", "maxItems": 8, "items": {"type": "object"}},
    "gate_results": {"type": "array", "maxItems": 32, "items": {"type": "object"}},
    "evidence": {"type": "array", "maxItems": 32, "items": {"type": "object"}},
    "nodes": {"type": "array", "maxItems": 16, "items": {"type": "object"}},
    "artifact_excerpts": {
      "type": "array",
      "maxItems": 4,
      "items": {"$ref": "#/$defs/artifactExcerpt"}
    },
    "basis_allowlist": {
      "type": "array",
      "description": "Set of citable refs; host-generated snapshots serialize it in lexicographic order.",
      "uniqueItems": true,
      "maxItems": 80,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifactExcerpt": {
      "type": "object",
      "required": ["ref", "selection", "truncated", "original_bytes", "text"],
      "properties": {
        "ref": {"type": "string", "minLength": 1, "maxLength": 4096},
        "selection": {"enum": ["head", "tail"]},
        "truncated": {"type": "boolean"},
        "original_bytes": {"type": "integer", "minimum": 0},
        "text": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
