{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TS review evidence snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "operation",
    "scope",
    "context",
    "evidence",
    "artifact_excerpts",
    "basis_allowlist",
    "evidence_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "ts-review-evidence-snapshot/1"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "operation": {"type": "string", "minLength": 1, "maxLength": 128},
    "scope": {"$ref": "#/$defs/scope"},
    "context": {
      "type": "object",
      "required": ["workspace", "node", "backtrack"],
      "properties": {
        "workspace": {"type": "string"},
        "node": {"type": ["string", "null"]},
        "backtrack": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "object"}
    },
    "artifact_excerpts": {
      "type": "array",
      "maxItems": 4,
      "items": {"$ref": "#/$defs/artifactExcerpt"}
    },
    "basis_allowlist": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "evidence_ceiling": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {"enum": ["mechanism", "candidate", "tsfreq", "connectivity", "accepted_audit", "pathway_audit", "program"]}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "type": "object",
      "required": ["report_id", "node_ids", "hypothesis_id", "pathway_id"],
      "properties": {
        "report_id": {"type": ["string", "null"]},
        "node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "hypothesis_id": {"type": ["string", "null"]},
        "pathway_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "artifactExcerpt": {
      "type": "object",
      "required": ["ref", "selection", "truncated", "original_bytes", "text", "layer"],
      "properties": {
        "ref": {"type": "string", "minLength": 1, "maxLength": 4096},
        "selection": {"enum": ["head", "tail"]},
        "truncated": {"type": "boolean"},
        "original_bytes": {"type": "integer", "minimum": 0},
        "text": {"type": "string"},
        "layer": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "additionalProperties": false
    }
  }
}
