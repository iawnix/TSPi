{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tspi.iawnix.xyz/schema/tspi-session-control-response-v1.json",
  "title": "TSPi session control response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "session_id", "action", "accepted", "error"],
  "properties": {
    "schema_version": { "const": "tspi-session-control/1" },
    "request_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$" },
    "session_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" },
    "action": { "enum": ["snapshot", "prompt", "abort", "queue"] },
    "accepted": { "type": "boolean" },
    "operation_id": { "type": ["string", "null"] },
    "entry_id": { "type": ["string", "null"] },
    "cursor": { "type": "integer", "minimum": 0 },
    "snapshot": {},
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "snapshot" } } },
      "then": { "required": ["cursor", "snapshot"] }
    },
    {
      "if": { "properties": { "action": { "const": "prompt" } } },
      "then": { "required": ["operation_id"] }
    },
    {
      "if": { "properties": { "action": { "const": "abort" } } },
      "then": { "required": ["operation_id"] }
    },
    {
      "if": { "properties": { "action": { "const": "queue" } } },
      "then": { "required": ["entry_id"] }
    }
  ]
}
