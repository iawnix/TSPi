{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsphone.iawnix.xyz/schema/bridge-v3.json",
  "title": "TS Phone local bridge record",
  "type": "object",
  "required": [
    "protocolVersion",
    "type",
    "workspaceId",
    "sessionId",
    "instanceEpoch"
  ],
  "properties": {
    "protocolVersion": { "const": "ts-phone-bridge/3" },
    "type": {
      "enum": [
        "bridge.register",
        "bridge.registered",
        "bridge.heartbeat",
        "session.snapshot",
        "event.publish",
        "command.prompt",
        "command.abort",
        "command.ack",
        "approval.request",
        "approval.respond"
      ]
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "accessMode": { "enum": ["controller", "observer"] },
    "launchId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$",
      "description": "Host-owned launch binding. Unknown launch IDs cannot register as external CLIs."
    },
    "pid": { "type": "integer", "minimum": 1 },
    "workspaceRoot": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "instanceEpoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "sessionGeneration": { "type": "integer", "minimum": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "clientMessageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "clientKind": { "enum": ["phone", "terminal"] },
    "agentRunId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "approvalId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "turnId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "toolCallId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "toolName": { "type": "string", "minLength": 1, "maxLength": 160 },
    "preview": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "expiresAt": { "type": "string", "format": "date-time" },
    "message": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "approved": { "type": "boolean" },
    "ok": { "type": "boolean" },
    "errorCode": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,100}$"
    },
    "payload": {},
    "snapshot": { "$ref": "#/$defs/sessionSnapshot" }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "command.abort" } },
        "required": ["type"]
      },
      "then": { "required": ["agentRunId"] }
    },
    {
      "if": {
        "properties": {
          "type": { "const": "event.publish" },
          "eventType": { "const": "agent_start" }
        },
        "required": ["type", "eventType"]
      },
      "then": {
        "properties": {
          "payload": {
            "allOf": [
              { "$ref": "#/$defs/agentRunEvent" },
              { "properties": { "type": { "const": "agent_start" } } }
            ]
          }
        },
        "required": ["payload"]
      }
    },
    {
      "if": {
        "properties": {
          "type": { "const": "event.publish" },
          "eventType": { "const": "agent_settled" }
        },
        "required": ["type", "eventType"]
      },
      "then": {
        "properties": {
          "payload": {
            "allOf": [
              { "$ref": "#/$defs/agentRunEvent" },
              { "properties": { "type": { "const": "agent_settled" } } }
            ]
          }
        },
        "required": ["payload"]
      }
    }
  ],
  "$defs": {
    "agentRunEvent": {
      "type": "object",
      "required": ["type", "origin", "turnId", "agentRunId"],
      "properties": {
        "type": { "enum": ["agent_start", "agent_settled"] },
        "origin": { "enum": ["local", "extension", "phone", "terminal", "host", "unknown"] },
        "turnId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,160}$"
        },
        "agentRunId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,160}$"
        },
        "attempt": { "type": "integer", "minimum": 1 },
        "outcome": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "enum": ["completed", "failed", "cancelled"] },
            "problem": { "enum": ["provider_unavailable", "provider_rate_limited", "provider_auth_failed", "provider_error", "generation_incomplete"] },
            "httpStatus": { "type": "integer", "minimum": 400, "maximum": 599 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sessionRuntime": {
      "type": "object",
      "required": ["schemaVersion", "model", "updatedAt"],
      "properties": {
        "schemaVersion": { "const": "ts-phone-session-runtime/1" },
        "model": {
          "type": "object",
          "required": ["provider", "id"],
          "properties": {
            "provider": { "type": "string", "minLength": 1, "maxLength": 160 },
            "id": { "type": "string", "minLength": 1, "maxLength": 240 }
          },
          "additionalProperties": false
        },
        "context": {
          "type": "object",
          "required": ["usedTokens", "limitTokens", "measurement"],
          "properties": {
            "usedTokens": {
              "oneOf": [
                { "type": "integer", "minimum": 0 },
                { "type": "null" }
              ]
            },
            "limitTokens": { "type": "integer", "minimum": 1 },
            "measurement": { "const": "pi_estimate" }
          },
          "additionalProperties": false
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "sessionSnapshot": {
      "type": "object",
      "required": ["sessionId", "isStreaming", "messages"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$" },
        "sessionName": { "type": "string", "minLength": 1, "maxLength": 500 },
        "model": { "type": "string", "minLength": 1, "maxLength": 500 },
        "promptProblem": { "enum": ["model_unavailable", "model_auth_missing", "model_storage_unavailable", "model_check_failed"] },
        "modelControl": { "type": "boolean", "description": "Only true for a managed Worker with session-local settings; external CLIs cannot change their model through the Host." },
        "runtime": { "$ref": "#/$defs/sessionRuntime" },
        "thinkingLevel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "isStreaming": { "type": "boolean" },
        "agentRunId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,160}$"
        },
        "messages": { "type": "array", "maxItems": 500 },
        "messageIds": {
          "type": "array",
          "maxItems": 500,
          "items": { "type": "string", "pattern": "^[0-9a-f]{8}$" }
        },
        "hasMore": { "type": "boolean" },
        "nextBefore": { "type": "string", "pattern": "^[0-9a-f]{8}$" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "isStreaming": { "const": true } },
            "required": ["isStreaming"]
          },
          "then": { "required": ["agentRunId"] },
          "else": { "not": { "required": ["agentRunId"] } }
        }
      ]
    }
  }
}
