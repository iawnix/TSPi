{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsphone.iawnix.xyz/schema/events-v3.json",
  "title": "TS Phone session event envelope",
  "type": "object",
  "required": [
    "protocolVersion",
    "id",
    "workspaceId",
    "sessionId",
    "sessionRevision",
    "instanceEpoch",
    "sessionGeneration",
    "type",
    "payload",
    "at"
  ],
  "properties": {
    "protocolVersion": { "const": "ts-phone-events/3" },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}:[1-9][0-9]*$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "sessionRevision": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "instanceEpoch": { "type": ["string", "null"] },
    "sessionGeneration": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,100}$"
    },
    "payload": {},
    "at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "type": { "enum": ["session_state", "session.snapshot"] } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "currentAccessMode": { "enum": ["controller", "observer", null] },
              "runtimeOwner": { "enum": ["host", "external", null] },
              "canActivate": { "type": "boolean" },
              "managementRevision": { "type": "string" },
              "nextModel": { "type": "string" },
              "queueProblem": { "type": ["string", "null"] },
              "commands": { "type": "array", "maxItems": 35, "items": { "type": "object" } },
              "activation": { "$ref": "#/$defs/sessionActivation" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "agent_start" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "allOf": [
              { "$ref": "#/$defs/agentRunEvent" },
              { "properties": { "type": { "const": "agent_start" } } }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "agent_settled" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "allOf": [
              { "$ref": "#/$defs/agentRunEvent" },
              { "properties": { "type": { "const": "agent_settled" } } }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sessionActivation": {
      "type": "object",
      "required": ["modes"],
      "properties": {
        "modes": { "type": "array", "uniqueItems": true, "items": { "enum": ["controller", "observer"] } },
        "problem": { "type": "string", "maxLength": 160 },
        "conflict": {
          "type": "object",
          "required": ["sessionId", "sessionRevision", "owner", "switchable"],
          "properties": {
            "sessionId": { "type": "string", "maxLength": 160 },
            "sessionRevision": { "type": "string", "maxLength": 160 },
            "sessionName": { "type": "string" },
            "owner": { "enum": ["host", "external"] },
            "switchable": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agentRunEvent": {
      "type": "object",
      "required": ["type", "origin", "turnId", "agentRunId"],
      "properties": {
        "type": { "enum": ["agent_start", "agent_settled"] },
        "origin": { "enum": ["local", "extension", "phone", "terminal", "host", "unknown"] },
        "turnId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,160}$"
        },
        "agentRunId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,160}$"
        },
        "attempt": { "type": "integer", "minimum": 1 },
        "outcome": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "enum": ["completed", "failed", "cancelled"] },
            "problem": { "enum": ["provider_unavailable", "provider_rate_limited", "provider_auth_failed", "provider_error", "generation_incomplete"] },
            "httpStatus": { "type": "integer", "minimum": 400, "maximum": 599 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
