{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tspi.iawnix.xyz/contracts/tspi-monitor/1/monitor.schema.json",
  "title": "TSPi Job Monitor Monitor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "monitor_id",
    "workspace_id",
    "node_id",
    "job_id",
    "attempt_id",
    "job_digest",
    "session_id",
    "wake_policy",
    "notify_policy",
    "enabled",
    "created_at",
    "sequence",
    "last_state"
  ],
  "properties": {
    "schema_version": {
      "const": "ts-job-monitor/1"
    },
    "monitor_id": {
      "type": "string",
      "pattern": "^monitor_[a-f0-9]{24}$"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "pattern": "^node_[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[A-Za-z0-9_.:-]+$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^attempt_[A-Za-z0-9_.:-]+$"
    },
    "job_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "wake_policy": {
      "enum": [
        "none",
        "next_run"
      ]
    },
    "notify_policy": {
      "const": "none"
    },
    "enabled": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "last_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "queue_wait_reported": {
      "type": "boolean"
    }
  }
}
