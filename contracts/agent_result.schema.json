{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iawnix:ts-agent-result:1",
  "title": "TS isolated agent result",
  "type": "object",
  "required": ["schema_version", "task_id", "role", "authority", "operation", "outcome", "summary", "scope", "facts", "artifact_refs", "program", "payload", "limitations", "provenance"],
  "properties": {
    "schema_version": {"const": "ts-agent-result/1"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "role": {"enum": ["review", "compute"]},
    "authority": {"enum": ["advisory", "operational"]},
    "operation": {"type": "string", "minLength": 1, "maxLength": 128},
    "outcome": {"enum": ["success", "partial", "failure", "not_run"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "scope": {"$ref": "urn:iawnix:ts-agent-task:2#/$defs/scope"},
    "facts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["kind", "statement", "status", "basis_refs"],
        "properties": {
          "kind": {"enum": ["review", "compute_preparation", "submission", "inspection", "collection", "cancellation", "parser"]},
          "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
          "status": {"enum": ["observed", "supported", "contradicted", "uncertain"]},
          "basis_refs": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}
        },
        "additionalProperties": false
      }
    },
    "artifact_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "program": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["outcome", "state", "error_class", "exit_status"],
          "properties": {
            "outcome": {"enum": ["success", "failure", "not_run"]},
            "state": {"type": ["string", "null"], "maxLength": 64},
            "error_class": {"type": ["string", "null"], "maxLength": 256},
            "exit_status": {"type": ["integer", "null"]}
          },
          "additionalProperties": false
        }
      ]
    },
    "payload": {"type": "object"},
    "limitations": {"type": "array", "maxItems": 24, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "provenance": {"type": "object"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "review"}}},
      "then": {
        "properties": {
          "authority": {"const": "advisory"},
          "operation": {"const": "claim_review"},
          "facts": {"items": {"properties": {"kind": {"const": "review"}}}},
          "artifact_refs": {"maxItems": 0},
          "program": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"role": {"const": "compute"}}},
      "then": {
        "properties": {
          "authority": {"const": "operational"},
          "operation": {"enum": ["launch", "inspect", "finalize", "cancel"]},
          "facts": {"items": {"properties": {"kind": {"enum": ["compute_preparation", "submission", "inspection", "collection", "cancellation", "parser"]}}}},
          "program": {"type": "object"}
        }
      }
    }
  ]
}
